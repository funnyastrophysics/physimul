현과 관의 정상파
  <h1>현과 관의 정상파</h1>
  <p class="hint" id="hintTxt"></p>
  <div class="card">
    <div class="tabs" id="tabs">
      <button data-m="str">줄 (현악기)</button>
      <button data-m="pipe">관 (관악기)</button>
    </div>
    <canvas id="sim" style="height:280px;background:#fbfcfd;border-radius:8px"></canvas>
    <div class="row">
      <button class="b" id="dnB">− 배수</button><button class="b" id="upB">+ 배수</button>
      <select id="pipeS" class="m-pipe"><option value="open">열린 관 (양쪽 열림)</option><option value="closed">닫힌 관 (한쪽 막힘)</option></select>
      <button class="b primary" id="sndB">소리 듣기</button>
      <label class="chk m-str"><input type="checkbox" id="cTrav"> 두 진행파 보기</label>
      <label class="chk"><input type="checkbox" id="cSlow"> 느리게</label>
    </div>
    <div class="stats" id="stats"></div>
  </div>
  <div class="card">
    <div class="controls">
      <div class="sl"><div class="top"><span>길이 L</span><b id="LV"></b></div>
        <input type="range" id="LS" min="0.3" max="1" step="0.01" value="0.65"><div class="range"><span>0.3 m</span><span>1 m</span></div></div>
      <div class="sl m-str"><div class="top"><span>줄에서 파동의 속력 v</span><b id="vV"></b></div>
        <input type="range" id="vS" min="100" max="400" step="10" value="200"><div class="range"><span>100 m/s (느슨함)</span><span>400 m/s (팽팽함)</span></div></div>
    </div>
    <p class="note" id="noteTxt"></p>
  </div>
---SCRIPT---
const S = $('sim'); let s; const rs = () => { s = fitCanvas(S); }; window.addEventListener('resize', rs);
let mode, n = 1, t = 0, snd = null;
bindLabels({ LS: ['LV', v => v.toFixed(2) + ' m'], vS: ['vV', v => v + ' m/s'] });
const closed = () => mode === 'pipe' && $('pipeS').value === 'closed';
// 몇 번째 정상파인지에 따라 파장 결정
function info(){ const L = +$('LS').value; if (mode === 'str'){ const v = +$('vS').value, lam = 2 * L / n; return { v, lam, f: v / lam, h: n }; }
  const v = 340; if (closed()){ const h = 2 * n - 1, lam = 4 * L / h; return { v, lam, f: v / lam, h }; } const lam = 2 * L / n; return { v, lam, f: v / lam, h: n }; }
// 변위 모양 (0 ≤ u ≤ 1, u는 길이에 대한 비율)
function shape(u){ const I = info(), L = +$('LS').value, K = 2 * Math.PI * L / I.lam;
  if (mode === 'str') return Math.sin(K * u); if (closed()) return Math.cos(K * u); return Math.cos(K * u); }
function draw(dt){
  const { ctx, W, H } = s; ctx.clearRect(0, 0, W, H); t += dt * ($('cSlow').checked ? 0.25 : 1);
  const I = info(), L = +$('LS').value, x0 = 24, x1 = x0 + (W - 48) * (L / 1), cy = H * 0.5, A = H * 0.26, w = 2 * Math.PI * 0.9 * Math.sqrt(I.h), cs = Math.cos(w * t);
  const X = u => x0 + (x1 - x0) * u, N = 160;
  if (mode === 'str'){
    ctx.fillStyle = '#8a8f99'; ctx.fillRect(x0 - 8, cy - 30, 8, 60); ctx.fillRect(x1, cy - 30, 8, 60);
    line(ctx, Array.from({ length: N + 1 }, (_, i) => [X(i / N), cy - A * shape(i / N)]), 'rgba(142,68,173,0.35)', 1.2, [4, 4]);
    line(ctx, Array.from({ length: N + 1 }, (_, i) => [X(i / N), cy + A * shape(i / N)]), 'rgba(142,68,173,0.35)', 1.2, [4, 4]);
    if ($('cTrav').checked){ const K = 2 * Math.PI * L / I.lam;
      line(ctx, Array.from({ length: N + 1 }, (_, i) => [X(i / N), cy - A / 2 * Math.sin(K * i / N - w * t)]), ORANGE, 1.6);
      line(ctx, Array.from({ length: N + 1 }, (_, i) => [X(i / N), cy - A / 2 * Math.sin(K * i / N + w * t)]), BLUE, 1.6);
      T(ctx, '오른쪽으로 진행', 8, 16, { color: ORANGE, bold: true, size: 11, align: 'left' }); T(ctx, '왼쪽으로 진행', 8, 32, { color: BLUE, bold: true, size: 11, align: 'left' }); }
    line(ctx, Array.from({ length: N + 1 }, (_, i) => [X(i / N), cy - A * shape(i / N) * cs]), INK, 3);
  } else {
    const ph = H * 0.3, top = cy - ph / 2;
    ctx.fillStyle = 'rgba(201,162,39,0.12)'; ctx.fillRect(x0, top, x1 - x0, ph);
    line(ctx, [[x0, top], [x1, top]], '#a98a2a', 3); line(ctx, [[x0, top + ph], [x1, top + ph]], '#a98a2a', 3);
    if (closed()){ ctx.fillStyle = '#a98a2a'; ctx.fillRect(x1, top - 2, 7, ph + 4); }
    // 공기 입자 (종파: 가로 방향 변위)
    const cols = Math.round((x1 - x0) / 9), rows = 5, dmax = Math.min(10, (x1 - x0) / I.h * 0.12);
    ctx.fillStyle = BLUE;
    for (let j = 0; j < rows; j++) for (let i = 0; i <= cols; i++){ const u = i / cols, px = X(u) + dmax * shape(u) * cs; if (closed() && px > x1 - 2) continue;
      ctx.beginPath(); ctx.arc(px, top + ph * (j + 0.5) / rows, 2.2, 0, 7); ctx.fill(); }
    // 변위 그래프 (관 위·아래)
    const ga = H * 0.14;
    line(ctx, Array.from({ length: N + 1 }, (_, i) => [X(i / N), top - 14 - ga / 2 - ga / 2 * shape(i / N) * cs]), INK, 2);
    line(ctx, Array.from({ length: N + 1 }, (_, i) => [X(i / N), top - 14 - ga / 2 - ga / 2 * shape(i / N)]), 'rgba(142,68,173,0.35)', 1, [4, 4]);
    line(ctx, Array.from({ length: N + 1 }, (_, i) => [X(i / N), top - 14 - ga / 2 + ga / 2 * shape(i / N)]), 'rgba(142,68,173,0.35)', 1, [4, 4]);
    T(ctx, '공기의 변위', x0, 12, { size: 11, bold: true, align: 'left', color: SUB });
  }
  // 마디(N)와 배(A) 표시
  const ny = mode === 'str' ? cy + A + 18 : cy + H * 0.15 + 16;
  for (let i = 0; i <= 400; i++){ const u = i / 400, a = shape(u), b = shape(Math.min(1, u + 1 / 400));
    if (i < 400 && (a === 0 || a * b < 0)) T(ctx, '마디', X(u), ny, { size: 10, color: RED, bold: true });
    const prev = shape(Math.max(0, u - 1 / 400)); if ((Math.abs(a) >= Math.abs(prev) && Math.abs(a) >= Math.abs(b) && Math.abs(a) > 0.995)) T(ctx, '배', X(u), ny + 14, { size: 10, color: GREEN, bold: true }); }
  if (Math.abs(shape(0)) < 1e-9) T(ctx, '마디', X(0), ny, { size: 10, color: RED, bold: true });
  if (Math.abs(shape(1)) < 1e-6) T(ctx, '마디', X(1), ny, { size: 10, color: RED, bold: true });
  if (snd) snd.set(I.f, 0.15);
  const ord = closed() ? `기본 진동의 ${I.h}배` : (I.h === 1 ? '기본 진동' : `${I.h}배 진동`);
  setStats([['진동 모드', ord, PURPLE], ['파장 λ', I.lam.toFixed(3) + ' m'], ['진동수 f = v/λ', I.f.toFixed(0) + ' Hz', ORANGE], ['파동의 속력 v', I.v + ' m/s']]);
  $('dnB').disabled = n <= 1; $('upB').disabled = n >= 6;
}
const TEXT = {
  str: ['양 끝이 고정된 줄에 생기는 정상파입니다. 배수를 바꾸고 줄의 길이와 파동의 속력을 조절하며 진동수의 변화를 확인하세요.',
    '양 끝이 고정된 줄에서는 양 끝이 항상 마디가 되므로 줄의 길이가 반파장의 정수배일 때만 정상파가 생깁니다(L = nλ/2, f = nv/2L). 반대 방향으로 진행하는 두 파동이 중첩되어 정상파가 만들어집니다. 기타 줄을 짧게 누르거나 팽팽하게 조이면 높은 소리가 납니다.'],
  pipe: ['관 속 공기 기둥에 생기는 정상파입니다. 파란 점은 공기 입자의 움직임(종파)이고, 위의 그래프는 공기의 변위입니다. 열린 관과 닫힌 관을 비교하세요.',
    '관의 열린 끝은 공기가 자유롭게 움직이므로 변위의 배, 막힌 끝은 공기가 움직일 수 없으므로 변위의 마디가 됩니다. 열린 관에서는 L = nλ/2로 모든 정수배 진동이 생기고, 닫힌 관에서는 L = (2n−1)λ/4로 홀수배 진동만 생깁니다. 같은 길이라면 닫힌 관의 기본 진동수가 열린 관의 절반입니다. 리코더, 팬플루트 등에 이용됩니다.'] };
setupTabs(m => { mode = m; n = 1; $('hintTxt').textContent = TEXT[m][0]; $('noteTxt').textContent = TEXT[m][1]; rs(); });
$('dnB').addEventListener('click', () => { n = Math.max(1, n - 1); }); $('upB').addEventListener('click', () => { n = Math.min(6, n + 1); });
$('pipeS').addEventListener('change', () => { n = 1; });
$('sndB').addEventListener('click', () => { if (snd){ snd.stop(); snd = null; $('sndB').textContent = '소리 듣기'; } else { snd = tone(); $('sndB').textContent = '소리 끄기'; } });
loop(draw);
