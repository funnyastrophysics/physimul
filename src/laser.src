레이저와 유도 방출
  <h1>레이저와 유도 방출</h1>
  <p class="hint" id="hintTxt"></p>
  <div class="card">
    <div class="tabs" id="tabs">
      <button data-m="one">흡수와 방출</button>
      <button data-m="laser">레이저</button>
    </div>
    <canvas id="sim" style="height:260px;border-radius:8px;background:#141a28"></canvas>
    <div class="row m-one"><button class="b primary" id="shootB">광자 보내기</button><button class="b" id="exciteB">원자에 에너지 공급</button></div>
    <p class="note m-one" id="msg" style="font-weight:700;color:#1d2330;min-height:3.1em"></p>
    <div class="stats" id="stats"></div>
  </div>
  <div class="card">
    <div class="sl m-laser"><div class="top"><span>외부에서 공급하는 에너지 (펌핑)</span><b id="pV"></b></div>
      <input type="range" id="pS" min="0" max="100" step="5" value="20"><div class="range"><span>0</span><span>세게</span></div></div>
    <p class="note" id="noteTxt"></p>
  </div>
---SCRIPT---
const S = $('sim'); let s; const rs = () => { s = fitCanvas(S); layout(); }; window.addEventListener('resize', rs);
let mode, t = 0, ph = [], atom = { ex: false, tEx: 0, life: 4 }, atoms = [], outN = 0, outRate = 0, outBuf = [];
const PALE = '#c9d2e3', DIM = '#8d97aa', PH = '#ff6b5e', SP = 130;
bindLabels({ pS: ['pV', v => v === 0 ? '0' : v + ' %'] });
function layout(fresh){ if (!s) return; const { W, H } = s, x0 = W * 0.1, x1 = W * 0.78, cy = H * 0.47; if (fresh || atoms.length !== 24){ atoms = Array.from({ length: 24 }, () => ({ ex: false })); ph = []; outN = 0; outBuf = []; }
  atoms.forEach((a, k) => { a.x = x0 + (x1 - x0) * (k % 8 + 0.7) / 8.4; a.y = cy + (Math.floor(k / 8) - 1) * 34; }); }
function photon(ctx, p, col){ const a = Math.atan2(p.vy, p.vx), n = 14; ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(a); ctx.strokeStyle = col || PH; ctx.lineWidth = 2; ctx.beginPath();
  for (let i = 0; i <= n; i++){ const u = i / n, x = -18 + 18 * u, y = Math.sin(u * Math.PI * 4) * 4 * Math.sin(u * Math.PI); i ? ctx.lineTo(x, y) : ctx.moveTo(x, y); } ctx.stroke();
  ctx.fillStyle = col || PH; ctx.beginPath(); ctx.moveTo(4, 0); ctx.lineTo(-3, -4); ctx.lineTo(-3, 4); ctx.fill(); ctx.restore(); }
function atomDraw(ctx, x, y, ex, r){ ctx.strokeStyle = 'rgba(201,210,227,0.35)'; ctx.lineWidth = 1; ctx.beginPath(); ctx.arc(x, y, r * 0.5, 0, 7); ctx.stroke(); ctx.beginPath(); ctx.arc(x, y, r, 0, 7); ctx.stroke();
  ctx.fillStyle = '#e8eefb'; ctx.beginPath(); ctx.arc(x, y, r * 0.2, 0, 7); ctx.fill();
  const rr = ex ? r : r * 0.5, a = t * 3; ctx.fillStyle = ex ? ORANGE : '#6aa2ff'; ctx.beginPath(); ctx.arc(x + Math.cos(a) * rr, y + Math.sin(a) * rr, Math.max(2.5, r * 0.14), 0, 7); ctx.fill(); }
const say = m => { $('msg').textContent = m; };
function drawOne(dt){
  const { ctx, W, H } = s, ax = W * 0.5, ay = H * 0.55;
  // 에너지 준위 그림
  const lx = W - 92, ly1 = 58, ly0 = 92; T(ctx, '에너지 준위', lx + 36, 22, { color: PALE, size: 11, bold: true });
  line(ctx, [[lx, ly1], [lx + 72, ly1]], PALE, 2); line(ctx, [[lx, ly0], [lx + 72, ly0]], PALE, 2);
  T(ctx, '들뜬상태', lx - 4, ly1, { color: DIM, size: 10, align: 'right' }); T(ctx, '바닥상태', lx - 4, ly0, { color: DIM, size: 10, align: 'right' });
  ctx.fillStyle = atom.ex ? ORANGE : '#6aa2ff'; ctx.beginPath(); ctx.arc(lx + 36, atom.ex ? ly1 : ly0, 5, 0, 7); ctx.fill();
  T(ctx, '광자가 나오는 곳', 8, ay - 22, { color: DIM, size: 10, align: 'left' }); ctx.fillStyle = PALE; ctx.fillRect(0, ay - 10, 8, 20);
  atomDraw(ctx, ax, ay, atom.ex, 34); T(ctx, atom.ex ? '들뜬상태' : '바닥상태', ax, ay + 52, { color: atom.ex ? ORANGE : '#8fb8ff', bold: true });
  if (atom.ex){ atom.tEx += dt; if (atom.tEx > atom.life){ atom.ex = false; const a = (0.25 + Math.random() * 1.5) * Math.PI * (Math.random() < 0.5 ? 1 : -1) ; ph.push({ x: ax, y: ay, vx: Math.cos(a) * SP, vy: Math.sin(a) * SP });
      say('자발 방출: 들뜬상태의 전자가 저절로 바닥상태로 내려오며 광자를 방출합니다. 방출 방향은 제각각입니다.'); } }
  ph.forEach(p => { const px = p.x; p.x += p.vx * dt; p.y += p.vy * dt;
    if (p.inc && px < ax && p.x >= ax){ p.inc = false;
      if (!atom.ex){ p.dead = true; atom.ex = true; atom.tEx = 0; atom.life = 4 + Math.random() * 3; say('흡수: 바닥상태의 전자가 광자의 에너지를 흡수하여 들뜬상태가 됩니다.'); }
      else { atom.ex = false; ph.push({ x: p.x, y: p.y + 12, vx: p.vx, vy: 0 }); say('유도 방출: 들어온 광자와 진동수, 위상, 진행 방향이 같은 광자가 하나 더 방출됩니다. 빛이 2배로 증폭되었습니다.'); } } });
  ph = ph.filter(p => !p.dead && p.x > -30 && p.x < W + 30 && p.y > -30 && p.y < H + 30); ph.forEach(p => photon(ctx, p));
  setStats([['원자의 상태', atom.ex ? '들뜬상태' : '바닥상태', atom.ex ? ORANGE : BLUE], ['광자의 에너지', '두 준위의 에너지 차와 같음']]);
}
function drawLaser(dt){
  const { ctx, W, H } = s, x0 = W * 0.1, x1 = W * 0.78, cy = H * 0.47, P = +$('pS').value / 100;
  ctx.fillStyle = 'rgba(120,160,255,0.07)'; ctx.fillRect(x0, cy - 58, x1 - x0, 116);
  ctx.fillStyle = PALE; ctx.fillRect(x0 - 7, cy - 62, 7, 124); ctx.fillStyle = 'rgba(201,210,227,0.55)'; ctx.fillRect(x1, cy - 62, 4, 124);
  T(ctx, '전반사 거울', x0 + 2, cy + 78, { color: PALE, size: 10, align: 'left' }); T(ctx, '부분 투과 거울', x1 + 4, cy + 78, { color: PALE, size: 10, align: 'right' });
  T(ctx, '레이저 빛 →', (x1 + W) / 2 + 2, cy - 74, { color: PH, size: 11, bold: true });
  if (P > 0) for (let k = 0; k < 5; k++){ const x = x0 + (x1 - x0) * (k + 0.5) / 5; arrow(ctx, x, 6, x, 6 + 8 + 12 * P, YELLOW, 2, 6); }
  atoms.forEach(a => {
    if (!a.ex){ if (Math.random() < P * 1.6 * dt) a.ex = true; }
    else if (Math.random() < 0.3 * dt){ a.ex = false; const ang = Math.random() * Math.PI * 2, ax = Math.abs(Math.sin(ang)) < 0.26;
      ph.push(ax ? { x: a.x, y: a.y, vx: Math.sign(Math.cos(ang)) * SP, vy: 0, ax: true } : { x: a.x, y: a.y, vx: Math.cos(ang) * SP, vy: Math.sin(ang) * SP }); }
    atomDraw(ctx, a.x, a.y, a.ex, 9); });
  const add = [];
  ph.forEach(p => { const px = p.x; p.x += p.vx * dt; p.y += p.vy * dt;
    if (p.ax && !p.out){
      if (p.x < x0){ p.x = x0; p.vx = SP; }
      if (p.x > x1){ if (Math.random() < 0.2){ p.out = true; outN++; outBuf.push(t); } else { p.x = x1; p.vx = -SP; } }
      for (const a of atoms){ if (Math.abs(a.y - p.y) > 10 || (px - a.x) * (p.x - a.x) > 0) continue;
        if (a.ex){ if (Math.random() < 0.4 && ph.length + add.length < 110){ a.ex = false; add.push({ x: p.x, y: a.y + (Math.random() - 0.5) * 12, vx: p.vx, vy: 0, ax: true }); } }
        else if (Math.random() < 0.4){ a.ex = true; p.dead = true; break; } } } });
  ph = ph.concat(add).filter(p => !p.dead && p.x > -30 && p.x < W + 30 && p.y > -30 && p.y < H + 30);
  ph.forEach(p => photon(ctx, p, p.ax ? PH : 'rgba(255,107,94,0.4)'));
  outBuf = outBuf.filter(v => v > t - 2); outRate += (outBuf.length / 2 - outRate) * Math.min(1, dt * 2);
  const nEx = atoms.filter(a => a.ex).length, inv = nEx > atoms.length / 2;
  setStats([['들뜬상태 원자', nEx + ' / ' + atoms.length, ORANGE], ['밀도 반전', inv ? '이루어짐' : '안 됨', inv ? GREEN : SUB], ['공진기 속 광자', String(ph.filter(p => p.ax && !p.out).length)], ['레이저 출력', fmt(outRate, 1) + ' 개/초', RED]]);
}
function draw(dt){ const { ctx, W, H } = s; ctx.clearRect(0, 0, W, H); t += dt; if (mode === 'one') drawOne(dt); else drawLaser(dt); }
const TEXT = {
  one: ['원자 하나에 광자를 보냅니다. 원자가 바닥상태일 때와 들뜬상태일 때 광자를 보내면 각각 어떤 일이 일어나는지 비교하세요.',
    '빛과 물질이 상호작용하는 기본 방식은 흡수와 방출입니다. 들뜬상태의 원자는 잠시 뒤 저절로 빛을 방출하는데(자발 방출), 이때 나오는 빛은 방향과 위상이 제각각입니다. 한편 들뜬상태의 원자에 두 준위의 에너지 차와 같은 에너지를 가진 광자가 들어오면, 들어온 광자와 똑같은 광자가 하나 더 방출됩니다(유도 방출). 레이저는 이 유도 방출을 이용해 빛을 증폭합니다.'],
  laser: ['두 거울 사이(공진기)에 원자들이 들어 있습니다. 외부에서 공급하는 에너지를 늘리며 레이저 빛이 나오기 시작하는 조건을 찾으세요. 주황색 전자가 들뜬상태의 원자입니다.',
    '외부에서 에너지를 공급하여 들뜬상태의 원자가 바닥상태의 원자보다 많아지면(밀도 반전), 흡수되는 광자보다 유도 방출되는 광자가 많아져 빛이 증폭됩니다. 거울 사이를 왕복하며 증폭된 빛의 일부가 부분 투과 거울을 통과해 나온 것이 레이저 빛입니다. 레이저 빛은 진동수가 같고(단색성), 위상이 같으며(결맞음), 퍼지지 않고 곧게 나아갑니다(직진성). 광통신, 바코드 판독, 광디스크, 레이저 수술, 정밀 가공, 거리 측정에 쓰입니다. 레이저 빛을 눈에 직접 비추면 위험합니다.'] };
setupTabs(m => { mode = m; $('hintTxt').textContent = TEXT[m][0]; $('noteTxt').textContent = TEXT[m][1]; rs(); layout(true); atom.ex = false; say('‘광자 보내기’를 눌러 보세요.'); });
$('shootB').addEventListener('click', () => { ph.push({ x: 8, y: s.H * 0.55, vx: SP, vy: 0, inc: true }); });
$('exciteB').addEventListener('click', () => { atom.ex = true; atom.tEx = 0; atom.life = 5 + Math.random() * 3; say('에너지를 공급받아 전자가 들뜬상태가 되었습니다. 저절로 내려오기 전에 광자를 보내 보세요.'); });
loop(draw);
