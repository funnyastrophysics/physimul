터널 효과
  <h1>터널 효과</h1>
  <p class="hint" id="hintTxt"></p>
  <div class="card">
    <div class="tabs" id="tabs">
      <button data-m="classic">공 (고전)</button>
      <button data-m="quantum">전자 (양자)</button>
      <button data-m="stm">현미경 (STM)</button>
    </div>
    <canvas id="sim" style="height:280px;border-radius:8px;background:#fbfcfd"></canvas>
    <div class="row m-quantum"><button class="b primary" id="fireB">전자 100개 보내기</button><button class="b" id="clrB">기록 지우기</button></div>
    <div class="stats" id="stats"></div>
  </div>
  <div class="card">
    <div class="controls">
      <div class="sl m-classic m-quantum"><div class="top"><span id="eL">입자의 에너지</span><b id="eV"></b></div>
        <input type="range" id="eS" min="0.5" max="6" step="0.1" value="2"><div class="range"><span>작음</span><span>큼</span></div></div>
      <div class="sl m-classic m-quantum"><div class="top"><span id="uL">장벽의 높이</span><b id="uV"></b></div>
        <input type="range" id="uS" min="1" max="6" step="0.1" value="4"><div class="range"><span>낮음</span><span>높음</span></div></div>
      <div class="sl m-classic m-quantum"><div class="top"><span>장벽의 폭</span><b id="wV"></b></div>
        <input type="range" id="wS" min="0.1" max="1" step="0.05" value="0.3"><div class="range"><span>좁음</span><span>넓음</span></div></div>
      <div class="sl m-stm"><div class="top"><span>탐침의 높이</span><b id="hV"></b></div>
        <input type="range" id="hS" min="0.3" max="0.8" step="0.02" value="0.5"><div class="range"><span>시료에 가까이</span><span>멀리</span></div></div>
    </div>
    <p class="note" id="noteTxt"></p>
  </div>
---SCRIPT---
const S = $('sim'); let s; const rs = () => { s = fitCanvas(S); }; window.addEventListener('resize', rs);
let mode, t = 0, ball = { x: 0, dir: 1 }, parts = [], toFire = 0, fireAcc = 0, nT = 0, nR = 0, tipX = 0, tipDir = 1, scan = [];
const unit = () => mode === 'classic' ? ' J' : ' eV';
const upLab = bindLabels({ eS: ['eV', v => v.toFixed(1) + unit()], uS: ['uV', v => v.toFixed(1) + unit()], wS: ['wV', v => mode === 'classic' ? (v * 10).toFixed(1) + ' m' : v.toFixed(2) + ' nm'], hS: ['hV', v => v.toFixed(2) + ' nm'] });
// 사각형 장벽의 투과 확률 (E, V: eV, w: nm)
function Tq(E, V, w){ if (Math.abs(E - V) < 1e-3) E += 2e-3; const K = 5.123;
  if (E < V){ const k = K * Math.sqrt(V - E), sh = Math.sinh(k * w); return 1 / (1 + V * V * sh * sh / (4 * E * (V - E))); }
  const k = K * Math.sqrt(E - V), sn = Math.sin(k * w); return 1 / (1 + V * V * sn * sn / (4 * E * (E - V))); }
const pct = p => p >= 0.9995 ? '100 %' : p >= 0.1 ? fmt(p * 100, 0) + ' %' : p >= 0.001 ? fmt(p * 100, p >= 0.01 ? 1 : 2) + ' %' : p < 1e-12 ? '거의 0 %' : '약 ' + (() => { const e = Math.floor(Math.log10(p)); return fmt(p / Math.pow(10, e), 0) + '×10' + String(e + 2).replace('-', '−').replace(/[−0-9]/g, c => ({ '−': '⁻', 0: '⁰', 1: '¹', 2: '²', 3: '³', 4: '⁴', 5: '⁵', 6: '⁶', 7: '⁷', 8: '⁸', 9: '⁹' })[c]) + ' %'; })();
function geo(){ const { W, H } = s, y0 = H - 46, sc = (y0 - 34) / 6.4, w = +$('wS').value * 110, xc = W * 0.52; return { W, H, y0, sc, x1: xc - w / 2, x2: xc + w / 2, xc, w, E: +$('eS').value, V: +$('uS').value }; }
function drawClassic(dt){
  const { ctx } = s, g = geo(), sig = g.w / 2 + 14, U = x => g.V * Math.exp(-(((x - g.xc) / sig) ** 4));
  // 언덕
  ctx.fillStyle = '#dfe6f1'; ctx.beginPath(); ctx.moveTo(0, g.y0); for (let x = 0; x <= g.W; x += 3) ctx.lineTo(x, g.y0 - U(x) * g.sc); ctx.lineTo(g.W, g.y0); ctx.fill();
  const pts = []; for (let x = 0; x <= g.W; x += 3) pts.push([x, g.y0 - U(x) * g.sc]); line(ctx, pts, WIRE, 2);
  line(ctx, [[0, g.y0 - g.E * g.sc], [g.W, g.y0 - g.E * g.sc]], RED, 1.5, true); T(ctx, '공의 역학적 에너지', 6, g.y0 - g.E * g.sc - 9, { align: 'left', color: RED, size: 11 });
  T(ctx, '언덕 꼭대기의 퍼텐셜 에너지', g.xc, g.y0 - g.V * g.sc - 12, { size: 11, color: INK });
  const k = Math.max(g.E - U(ball.x), 0); let v = 60 + 150 * Math.sqrt(k / 6);
  if (g.E < g.V && k < 0.03 && ball.dir > 0 && ball.x < g.xc) ball.dir = -1;
  ball.x += ball.dir * v * dt; if (ball.x > g.W + 12 || ball.x < -12){ ball.x = -10; ball.dir = 1; }
  ctx.fillStyle = RED; ctx.beginPath(); ctx.arc(ball.x, g.y0 - U(ball.x) * g.sc - 8, 8, 0, 7); ctx.fill();
  const pass = g.E >= g.V;
  setStats([['공의 역학적 에너지', g.E.toFixed(1) + ' J', RED], ['언덕을 넘는 데 필요한 에너지', g.V.toFixed(1) + ' J'], ['결과', pass ? '언덕을 넘어감' : '되돌아옴', pass ? GREEN : SUB], ['넘어갈 확률', pass ? '100 %' : '0 %']]);
}
function drawQuantum(dt){
  const { ctx } = s, g = geo(), p = Tq(g.E, g.V, g.w / 110), yE = g.y0 - g.E * g.sc;
  ctx.fillStyle = '#dfe6f1'; ctx.fillRect(g.x1, g.y0 - g.V * g.sc, g.w, g.V * g.sc); ctx.strokeStyle = WIRE; ctx.lineWidth = 2; ctx.strokeRect(g.x1, g.y0 - g.V * g.sc, g.w, g.V * g.sc);
  line(ctx, [[0, g.y0], [g.W, g.y0]], WIRE, 2); T(ctx, '퍼텐셜 장벽', g.xc, g.y0 - g.V * g.sc - 12, { size: 11, color: INK });
  line(ctx, [[0, yE], [g.W, yE]], RED, 1, true); T(ctx, '점선: 전자의 에너지', 6, g.y0 + 14, { align: 'left', color: RED, size: 11 });
  // 확률 파동 (입사파와 투과파)
  const lam = 46 / Math.sqrt(g.E), kk = 2 * Math.PI / lam, om = 5, A = 20, aT = Math.sqrt(p), pts = [];
  for (let x = 0; x <= g.W; x += 2){ let y;
    if (x < g.x1) y = A * Math.cos(kk * (x - g.x1) - om * t);
    else if (x <= g.x2) y = A * Math.pow(aT, (x - g.x1) / Math.max(1, g.w)) * Math.cos(-om * t);
    else y = A * aT * Math.cos(kk * (x - g.x2) - om * t);
    pts.push([x, yE - y]); }
  line(ctx, pts, PURPLE, 2); T(ctx, '전자의 확률 파동', g.W - 6, 16, { align: 'right', color: PURPLE, size: 11, bold: true });
  // 전자 하나씩
  if (toFire > 0){ fireAcc += dt * 25; while (fireAcc >= 1 && toFire > 0){ fireAcc--; toFire--; parts.push({ x: -5, y: g.y0 - 10 - Math.random() * 16, v: 260 + Math.random() * 60, pass: Math.random() < p, st: 0 }); } }
  parts.forEach(q => { const px = q.x; q.x += q.v * dt * (q.st === 2 ? -1 : 1);
    if (q.st === 0 && q.x >= g.x1 - 4){ if (q.pass){ q.st = 1; nT++; } else { q.st = 2; nR++; } } });
  parts = parts.filter(q => q.x > -10 && q.x < g.W + 10);
  parts.forEach(q => { ctx.fillStyle = q.st === 1 ? GREEN : q.st === 2 ? GRAY : BLUE; ctx.globalAlpha = q.st === 1 && q.x < g.x2 ? 0.35 : 1; ctx.beginPath(); ctx.arc(q.x, q.y, 3.5, 0, 7); ctx.fill(); ctx.globalAlpha = 1; });
  setStats([['통과할 확률 (이론)', pct(p), PURPLE], ['장벽을 통과한 전자', nT + '개', GREEN], ['반사된 전자', nR + '개'], ['고전 역학의 예상', g.E >= g.V ? '모두 통과' : '모두 반사']]);
}
function drawStm(dt){
  const { ctx, W, H } = s, r = 13, n = Math.floor((W - 20) / (2 * r)), xs = [], yS = 150, h = +$('hS').value, px = 80;   // 1 nm = 80 px
  const miss = Math.floor(n * 0.62); for (let i = 0; i < n; i++) if (i !== miss) xs.push((W - n * 2 * r) / 2 + r + i * 2 * r);
  const surf = x => { let m = -2 * r; for (const a of xs){ const d = Math.abs(x - a); if (d < r) m = Math.max(m, Math.sqrt(r * r - d * d) - r); } return m; };   // 원자 꼭대기 기준 높이(px), 빈자리는 아래층
  tipX += tipDir * 55 * dt; if (tipX > W - 14){ tipX = W - 14; tipDir = -1; scan = []; } if (tipX < 14){ tipX = 14; tipDir = 1; scan = []; }
  const tipY = yS - r - h * px, gap = (yS - r - surf(tipX) - tipY) / px, I = Math.exp(-2 * 10 * (gap - 0.3));
  scan.push([tipX, I]);
  // 시료
  ctx.fillStyle = '#c9d6ea'; for (let i = 0; i < n; i++){ const x = (W - n * 2 * r) / 2 + r + i * 2 * r; ctx.beginPath(); ctx.arc(x, yS + 2 * r, r, 0, 7); ctx.fill(); }
  xs.forEach(x => { ctx.fillStyle = '#7fa3d6'; ctx.strokeStyle = '#fff'; ctx.lineWidth = 1; ctx.beginPath(); ctx.arc(x, yS, r, 0, 7); ctx.fill(); ctx.stroke(); });
  T(ctx, '아래: 시료 표면의 원자', 8, 16, { align: 'left', size: 11 });
  // 탐침
  ctx.fillStyle = '#8b94a5'; ctx.beginPath(); ctx.moveTo(tipX, tipY); ctx.lineTo(tipX - 13, tipY - 44); ctx.lineTo(tipX + 13, tipY - 44); ctx.fill(); T(ctx, '탐침', tipX, tipY - 54, { size: 11, bold: true, color: INK });
  ctx.fillStyle = `rgba(142,68,173,${Math.min(1, 0.15 + I * 0.5)})`; for (let k = 0; k < 3; k++){ const yy = tipY + ((t * 60 + k * 9) % Math.max(4, gap * px)); ctx.beginPath(); ctx.arc(tipX, yy, 2.2, 0, 7); ctx.fill(); }
  // 전류 그래프
  const gy = H - 12, gh = 56, mx = Math.exp(-2 * 10 * (h - 0.3));
  line(ctx, [[14, gy], [W - 14, gy]], GRAY, 1); T(ctx, '탐침 위치에 따른 터널 전류', 8, gy - gh - 10, { align: 'left', size: 11, color: PURPLE, bold: true });
  if (scan.length > 1) line(ctx, scan.map(p => [p[0], gy - Math.min(1.05, p[1] / mx) * gh]), PURPLE, 2);
  setStats([['탐침과 원자 사이의 간격', gap.toFixed(2) + ' nm'], ['터널 전류 (상대값)', I >= 0.1 ? fmt(I, 2) : fmt(I, 4), PURPLE], ['간격이 0.1 nm 늘면', '전류가 약 1/7로']]);
}
function draw(dt){ const { ctx, W, H } = s; ctx.clearRect(0, 0, W, H); t += dt; if (mode === 'classic') drawClassic(dt); else if (mode === 'quantum') drawQuantum(dt); else drawStm(dt); }
const TEXT = {
  classic: ['고전 역학을 따르는 공이 언덕을 향해 굴러갑니다. 공의 역학적 에너지와 언덕의 높이를 바꾸며 공이 언덕을 넘는 조건을 찾으세요.',
    '고전 역학에서는 공의 역학적 에너지가 언덕 꼭대기에서의 퍼텐셜 에너지보다 작으면 공은 절대로 언덕을 넘지 못하고 되돌아옵니다. 언덕의 폭은 결과에 영향을 주지 않습니다.'],
  quantum: ['양자 역학을 따르는 전자가 자신의 에너지보다 높은 퍼텐셜 장벽을 만납니다. ‘전자 100개 보내기’를 누르고, 장벽의 높이와 폭을 바꾸며 통과하는 전자의 수를 비교하세요.',
    '전자와 같이 매우 작은 입자는 파동성을 가지므로, 자신의 에너지보다 높은 장벽을 만나도 장벽 너머에서 발견될 확률이 0이 아닙니다. 이 현상을 터널 효과라고 합니다. 전자 하나가 통과할지는 미리 알 수 없고 확률만 알 수 있으며, 장벽이 높을수록, 폭이 넓을수록 통과할 확률이 급격히 작아집니다. 태양 중심부에서 수소 원자핵이 전기적 반발력의 장벽을 넘어 핵융합하는 것도 터널 효과 때문입니다. 반도체 소자가 수 nm 크기로 작아지면 얇은 절연막을 전자가 통과해 새는 문제가 생기는데, 플래시 메모리는 오히려 이 효과를 이용해 정보를 저장합니다.'],
  stm: ['뾰족한 탐침이 시료 표면 위를 일정한 높이로 지나갑니다. 탐침과 시료는 떨어져 있지만 터널 효과로 전류가 흐릅니다. 원자가 빠진 자리에서 전류가 어떻게 달라지는지 찾으세요.',
    '주사 터널링 현미경(STM)은 탐침과 시료 사이의 빈 공간을 전자가 터널 효과로 건너갈 때 흐르는 전류를 측정합니다. 이 전류는 탐침과 시료 사이의 간격에 매우 민감해서, 간격이 원자 지름의 몇 분의 일만 달라져도 크게 변합니다. 그래서 표면을 훑으며 전류를 기록하면 원자 하나하나의 배열을 볼 수 있습니다. 원자 꼭대기 위에서는 전류가 크고 원자 사이에서는 작으며, 원자가 빠진 자리에서는 전류가 거의 흐르지 않습니다.'] };
setupTabs(m => { mode = m; $('hintTxt').textContent = TEXT[m][0]; $('noteTxt').textContent = TEXT[m][1]; $('eL').textContent = m === 'classic' ? '공의 역학적 에너지' : '전자의 에너지'; $('uL').textContent = m === 'classic' ? '언덕의 높이 (퍼텐셜 에너지)' : '장벽의 높이'; upLab(); parts = []; nT = nR = 0; toFire = 0; scan = []; ball = { x: -10, dir: 1 }; rs(); });
$('fireB').addEventListener('click', () => { toFire += 100; });
$('clrB').addEventListener('click', () => { parts = []; nT = nR = 0; toFire = 0; });
['eS', 'uS', 'wS'].forEach(id => $(id).addEventListener('input', () => { nT = nR = 0; parts = []; toFire = 0; }));
$('hS').addEventListener('input', () => { scan = []; });
loop(draw);
