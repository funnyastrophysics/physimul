실로 연결된 물체의 운동
  <h1>실로 연결된 물체의 운동</h1>
  <p class="hint" id="hintTxt"></p>
  <div class="card">
    <div class="tabs" id="tabs">
      <button data-m="table">수평면</button>
      <button data-m="atwood">도르래 양쪽</button>
      <button data-m="incl">양쪽 빗면</button>
    </div>
    <canvas id="sim" style="height:320px;border-radius:8px;background:#fbfcfd"></canvas>
    <div class="row">
      <button class="b primary" id="goB">놓기</button><button class="b" id="resetB">처음으로</button>
      <button class="b m-table m-atwood" id="swapB">A와 B 바꾸기</button>
      <button class="b m-incl" id="cutB">A와 B 사이의 실 끊기</button>
      <button class="b m-incl" id="balB">일정한 속력이 되게 기울기 맞추기</button>
    </div>
    <div class="stats" id="stats"></div>
  </div>
  <div class="card"><canvas id="graph" style="height:200px"></canvas></div>
  <div class="card">
    <div class="controls">
      <div class="sl"><div class="top"><span>A의 질량</span><b id="aV"></b></div>
        <input type="range" id="aS" min="0.5" max="5" step="0.5" value="1"><div class="range"><span>0.5 kg</span><span>5 kg</span></div></div>
      <div class="sl"><div class="top"><span>B의 질량</span><b id="bV"></b></div>
        <input type="range" id="bS" min="0.5" max="5" step="0.5" value="4"><div class="range"><span>0.5 kg</span><span>5 kg</span></div></div>
      <div class="sl m-incl"><div class="top"><span>C의 질량</span><b id="cV"></b></div>
        <input type="range" id="cS" min="0.5" max="5" step="0.5" value="2"><div class="range"><span>0.5 kg</span><span>5 kg</span></div></div>
      <div class="sl m-incl"><div class="top"><span>왼쪽 빗면의 기울기</span><b id="lV"></b></div>
        <input type="range" id="lS" min="15" max="60" step="1" value="30"><div class="range"><span>15°</span><span>60°</span></div></div>
      <div class="sl m-incl"><div class="top"><span>오른쪽 빗면의 기울기</span><b id="rV"></b></div>
        <input type="range" id="rS" min="15" max="60" step="0.1" value="48.6"><div class="range"><span>15°</span><span>60°</span></div></div>
      <div class="sl m-incl"><div class="top"><span>처음 속력 (C가 내려가는 방향)</span><b id="vV"></b></div>
        <input type="range" id="vS" min="0" max="2" step="0.1" value="0.8"><div class="range"><span>0 (정지)</span><span>2 m/s</span></div></div>
    </div>
    <p class="note" id="noteTxt"></p>
  </div>
---SCRIPT---
const S = $('sim'), G = $('graph'); let s, gr; const rs = () => { s = fitCanvas(S); gr = fitCanvas(G); }; window.addEventListener('resize', rs);
const g = 9.8, D = Math.PI / 180, BS = 24;
let mode, t = 0, run = false, done = '', x = 0, v = 0, cut = false, xA = 0, vA = 0, buf = [], cutX = 0, topC = null;
bindLabels({ aS: ['aV', v => v.toFixed(1) + ' kg'], bS: ['bV', v => v.toFixed(1) + ' kg'], cS: ['cV', v => v.toFixed(1) + ' kg'], lS: ['lV', v => v + '°'], rS: ['rV', v => (+v).toFixed(1) + '°'], vS: ['vV', v => v.toFixed(1) + ' m/s'] });
// 실의 방향(+: 오른쪽 물체가 내려가는 방향)으로 본 물체 목록. k: 중력 가운데 운동 방향 성분의 비율
function objs(){
  const mA = +$('aS').value, mB = +$('bS').value, mC = +$('cS').value;
  if (mode === 'table') return [{ n: 'A', m: mA, k: 0, c: BLUE }, { n: 'B', m: mB, k: 1, c: ORANGE }];
  if (mode === 'atwood') return [{ n: 'A', m: mA, k: -1, c: BLUE }, { n: 'B', m: mB, k: 1, c: ORANGE }];
  const k1 = -Math.sin(+$('lS').value * D), k2 = Math.sin(+$('rS').value * D);
  return [{ n: 'A', m: mA, k: k1, c: BLUE }, { n: 'B', m: mB, k: k1, c: ORANGE }, { n: 'C', m: mC, k: k2, c: GREEN }];
}
function accel(list){ let F = 0, M = 0; list.forEach(o => { F += o.m * g * o.k; M += o.m; }); return F / M; }
// 물체 사이의 실이 당기는 힘: 앞쪽 물체들만 묶어서 구한다
function tensions(list, a){ const T = []; let sum = 0; for (let i = 0; i < list.length - 1; i++){ sum += list[i].m * a - list[i].m * g * list[i].k; T.push(sum); } return T; }
function reset(){ t = 0; run = false; done = ''; x = 0; xA = 0; cut = false; buf = []; cutX = 0; topC = null; v = vA = mode === 'incl' ? +$('vS').value : 0; $('goB').textContent = mode === 'incl' && v > 0 ? '출발' : '놓기'; $('cutB').disabled = false; }
function geoIncl(){
  const { W, H } = s, a1 = +$('lS').value * D, a2 = +$('rS').value * D, ax = W / 2, ay = 62, by = H - 26;
  const L1 = Math.min((W / 2 - 12) / Math.cos(a1), (by - ay) / Math.sin(a1)), L2 = Math.min((W / 2 - 12) / Math.cos(a2), (by - ay) / Math.sin(a2));
  const ppm = 88; return { a1, a2, ax, ay, by, L1, L2, ppm, len1: L1 / ppm, len2: L2 / ppm };
}
function step(dt){
  if (!run || done) return;
  const o = objs(), n = 4, h = dt / n;
  for (let i = 0; i < n; i++){
    if (cut){ const aA = g * o[0].k, a = accel(o.slice(1)); vA += aA * h; xA += vA * h; v += a * h; x += v * h;
      if (topC === null && vA <= 0) topC = x - cutX; }
    else { const a = accel(o); v += a * h; x += v * h; xA = x; vA = v; }
    t += h;
    if (mode === 'table'){ if (x >= 0.8){ done = 'A가 L만큼 이동했습니다.'; break; } }
    else if (mode === 'atwood'){ if (Math.abs(x) >= 0.6){ done = '끝까지 이동했습니다.'; break; } }
    else { const q = geoIncl(), dA = 1.5 - xA, dB = 1.1 - x, dC = 0.45 + x;
      if (dB < 0.22 || dC < 0.22 || dC > q.len2 - 0.16 || dB > q.len1 - 0.16 || dA > q.len1 - 0.16 || (cut ? dA - dB < 0.3 && vA > v : false) || dA < 0.22){ done = '물체가 빗면의 끝에 닿아 멈췄습니다.'; break; } }
  }
  buf.push({ t, v, vA }); if (buf.length > 900) buf.shift();
  if (done){ run = false; $('goB').textContent = '놓기'; }
}
function box(ctx, cx, cy, ang, o){ ctx.save(); ctx.translate(cx, cy); ctx.rotate(ang); ctx.fillStyle = o.c; ctx.fillRect(-BS / 2, -BS / 2, BS, BS); ctx.restore(); T(ctx, o.n, cx, cy, { color: '#fff', bold: true, size: 13 }); }
function ghost(ctx, cx, cy, ang){ ctx.save(); ctx.translate(cx, cy); ctx.rotate(ang); ctx.strokeStyle = GRAY; ctx.setLineDash([3, 3]); ctx.strokeRect(-BS / 2, -BS / 2, BS, BS); ctx.setLineDash([]); ctx.restore(); }
function pulley(ctx, x, y, r){ ctx.fillStyle = '#fff'; ctx.strokeStyle = WIRE; ctx.lineWidth = 2; ctx.beginPath(); ctx.arc(x, y, r, 0, 7); ctx.fill(); ctx.stroke(); ctx.fillStyle = WIRE; ctx.beginPath(); ctx.arc(x, y, 2.5, 0, 7); ctx.fill(); }
function draw(dt){
  step(dt);
  const { ctx, W, H } = s, o = objs(); ctx.clearRect(0, 0, W, H);
  if (mode === 'table'){
    const ty = 120, px = W - 70, ppm = Math.min((W - 150) / 0.8, 170), x0 = px - 34 - 0.8 * ppm, by0 = ty + 36;
    ctx.fillStyle = '#e6e9f0'; ctx.fillRect(10, ty, px - 10, 12); line(ctx, [[10, ty], [px, ty]], WIRE, 2); line(ctx, [[px, ty], [px, H - 20]], WIRE, 2);
    const ax = x0 + x * ppm, bx = px + 18, byy = by0 + x * ppm;
    ghost(ctx, x0, ty - BS / 2, 0); ghost(ctx, bx, by0, 0);
    line(ctx, [[ax + BS / 2, ty - BS / 2], [px + 9, ty - BS / 2]], WIRE, 1.5); line(ctx, [[bx, ty - BS / 2 + 9], [bx, byy - BS / 2]], WIRE, 1.5);
    pulley(ctx, px + 9, ty - BS / 2 + 9, 9); box(ctx, ax, ty - BS / 2, 0, o[0]); box(ctx, bx, byy, 0, o[1]);
    line(ctx, [[x0, ty + 26], [x0 + 0.8 * ppm, ty + 26]], SUB, 1); line(ctx, [[x0, ty + 21], [x0, ty + 31]], SUB, 1); line(ctx, [[x0 + 0.8 * ppm, ty + 21], [x0 + 0.8 * ppm, ty + 31]], SUB, 1);
    T(ctx, 'L = 0.8 m', x0 + 0.4 * ppm, ty + 40, { size: 12 }); T(ctx, '수평면', 16, ty - 10, { align: 'left', size: 11 });
  } else if (mode === 'atwood'){
    const cx = W / 2, py = 52, r = 24, ppm = 150, y0 = 175;
    line(ctx, [[cx - 40, 14], [cx + 40, 14]], WIRE, 3); line(ctx, [[cx, 14], [cx, py]], WIRE, 2);
    const ya = y0 - x * ppm, yb = y0 + x * ppm;
    ghost(ctx, cx - r, y0, 0); ghost(ctx, cx + r, y0, 0);
    line(ctx, [[cx - r, py], [cx - r, ya - BS / 2]], WIRE, 1.5); line(ctx, [[cx + r, py], [cx + r, yb - BS / 2]], WIRE, 1.5);
    pulley(ctx, cx, py, r); box(ctx, cx - r, ya, 0, o[0]); box(ctx, cx + r, yb, 0, o[1]);
    line(ctx, [[20, H - 14], [W - 20, H - 14]], WIRE, 2);
  } else {
    const q = geoIncl(), P = q.ppm, hb = BS / 2 + 1;
    const dL = [-Math.cos(q.a1), Math.sin(q.a1)], nL = [-Math.sin(q.a1), -Math.cos(q.a1)], dR = [Math.cos(q.a2), Math.sin(q.a2)], nR = [Math.sin(q.a2), -Math.cos(q.a2)];
    ctx.fillStyle = '#e6e9f0'; ctx.beginPath(); ctx.moveTo(q.ax, q.ay); ctx.lineTo(q.ax + dL[0] * q.L1, q.ay + dL[1] * q.L1); ctx.lineTo(q.ax + dR[0] * q.L2, q.ay + dR[1] * q.L2); ctx.closePath(); ctx.fill();
    line(ctx, [[q.ax + dL[0] * q.L1, q.ay + dL[1] * q.L1], [q.ax, q.ay], [q.ax + dR[0] * q.L2, q.ay + dR[1] * q.L2]], WIRE, 2);
    const at = (d, n, dist) => [q.ax + d[0] * dist * P + n[0] * hb, q.ay + d[1] * dist * P + n[1] * hb];
    const pA = at(dL, nL, 1.5 - xA), pB = at(dL, nL, 1.1 - x), pC = at(dR, nR, 0.45 + x), tl = at(dL, nL, 0.05), tr = at(dR, nR, 0.05);
    ghost(ctx, ...at(dL, nL, 1.5), -q.a1); ghost(ctx, ...at(dL, nL, 1.1), -q.a1); ghost(ctx, ...at(dR, nR, 0.45), q.a2);
    if (!cut) line(ctx, [pA, pB], WIRE, 1.5); line(ctx, [pB, tl, tr, pC], WIRE, 1.5);
    pulley(ctx, q.ax, q.ay - hb + 1, 9); box(ctx, pA[0], pA[1], -q.a1, o[0]); box(ctx, pB[0], pB[1], -q.a1, o[1]); box(ctx, pC[0], pC[1], q.a2, o[2]);
    T(ctx, $('lS').value + '°', q.ax + dL[0] * q.L1 + 34, q.ay + dL[1] * q.L1 - 6, { size: 11 }); T(ctx, (+$('rS').value).toFixed(1) + '°', q.ax + dR[0] * q.L2 - 34, q.ay + dR[1] * q.L2 - 6, { size: 11 });
    if (cut) T(ctx, 'A와 B 사이의 실이 끊어짐', W / 2, 16, { color: RED, bold: true, size: 12 });
  }
  if (done) T(ctx, done, W / 2, mode === 'table' ? 24 : H - 4 - (mode === 'atwood' ? 16 : 0), { color: RED, bold: true, size: 12, base: mode === 'table' ? 'middle' : 'bottom' });
  // 값
  const f2 = (val, u) => fmt(val, 2) + ' ' + u;
  // 가속도를 중력 가속도 g의 몇 배인지로 나타낸다. 간단한 분수이면 분수로, 아니면 소수로.
  const inG = a => { const r = Math.abs(a) / g; if (r < 0.0005) return '0'; for (let d = 1; d <= 12; d++){ const n = Math.round(r * d); if (n > 0 && Math.abs(r - n / d) < 0.0006) return (a < 0 ? '−' : '') + (d === 1 ? (n === 1 ? '' : n) : n + '/' + d + ' ') + 'g'; } return fmt(a / g, 2) + ' g'; };
  const acc = a => f2(a, 'm/s²') + ' <span style="font-size:13px;font-weight:400;color:#5b6475">= ' + inG(a) + '</span>';
  if (mode === 'incl'){
    const aAll = accel(o), aA = cut ? g * o[0].k : aAll, aR = cut ? accel(o.slice(1)) : aAll, Tn = cut ? [0].concat(tensions(o.slice(1), aR)) : tensions(o, aAll);
    setStats([['A의 가속도', acc(aA), BLUE], ['B, C의 가속도', acc(aR), GREEN], ['A–B 실이 당기는 힘(장력)', cut ? '끊어짐' : f2(Tn[0], 'N')], ['B–C 실이 당기는 힘(장력)', f2(Tn[1], 'N')],
      ['A의 속도', f2(vA, 'm/s'), BLUE], ['C의 속도', f2(v, 'm/s'), GREEN], ['실이 끊어진 뒤 C의 이동 거리', cut ? f2(x - cutX, 'm') : '—'], ['A가 최고점일 때 C의 이동 거리', topC === null ? '—' : f2(topC, 'm'), ORANGE]]);
  } else {
    const a = accel(o), Tn = tensions(o, a);
    setStats([['가속도의 크기', acc(Math.abs(a)), ORANGE], ['실이 당기는 힘(장력)', f2(Tn[0], 'N')], ['속력', f2(Math.abs(v), 'm/s')], ['이동 거리', f2(Math.abs(x), 'm')], ['걸린 시간', f2(t, 's'), BLUE]]);
  }
  const names = cut ? ['B, C의 속도 (m/s)', 'A의 속도 (m/s)'] : [mode === 'incl' ? '속도 (m/s)  +: C가 내려가는 방향' : '속도 (m/s)'];
  timeGraph(gr.ctx, gr.W, gr.H, buf, t, [{ keys: cut ? ['v', 'vA'] : ['v'], names, colors: cut ? [GREEN, BLUE] : [ORANGE], min: 2, pos: mode === 'table' }], 3);
}
const TEXT = {
  table: ['수평면 위의 A와 매달린 B가 실로 연결되어 있습니다. ‘놓기’를 눌러 A가 L만큼 이동하는 데 걸리는 시간을 재고, ‘A와 B 바꾸기’를 눌러 비교하세요. 모든 마찰은 무시합니다.',
    '실로 연결된 두 물체는 가속도의 크기가 같으므로 한 덩어리로 보고 운동 방정식을 세울 수 있습니다. 두 물체를 움직이게 하는 힘은 매달린 물체에 작용하는 중력뿐이므로 가속도는 a = (매달린 물체의 질량 × g) ÷ (두 물체의 질량의 합)입니다. 정지 상태에서 출발해 L만큼 이동하는 데 걸리는 시간은 L = ½at²에서 t = √(2L/a)이므로, 가속도가 4배가 되면 걸리는 시간은 절반이 됩니다. 실이 당기는 힘(장력)은 수평면 위의 물체만 따로 보면 T = (그 물체의 질량) × a입니다.'],
  atwood: ['도르래 양쪽에 A와 B가 매달려 있습니다. 질량을 바꾸며 가속도와 실이 당기는 힘(장력)이 어떻게 달라지는지 확인하세요.',
    '무거운 쪽이 내려가고 가벼운 쪽이 올라갑니다. 두 물체를 한 덩어리로 보면 알짜힘은 두 물체에 작용하는 중력의 차이므로 a = (질량의 차 × g) ÷ (질량의 합)입니다. 실이 당기는 힘(장력)은 가벼운 물체의 무게보다 크고 무거운 물체의 무게보다 작습니다. 두 질량이 같으면 알짜힘이 0이어서 정지해 있거나 등속도 운동을 합니다.'],
  incl: ['양쪽 빗면 위의 A, B, C가 실로 연결되어 있습니다. 처음 속력을 주고 출발시킨 뒤 ‘A와 B 사이의 실 끊기’를 눌러, 끊어지기 전과 후의 가속도를 비교하세요. 모든 마찰은 무시합니다.',
    '빗면 위의 물체를 빗면 아래로 당기는 힘은 중력의 빗면 방향 성분(mg sinθ)입니다. 양쪽에서 이 힘의 크기가 같으면 알짜힘이 0이므로 세 물체는 일정한 속력으로 운동합니다. 실이 끊어지면 A는 중력의 빗면 방향 성분만 받아 속력이 줄다가 최고점에서 순간적으로 멈춘 뒤 내려오고, B와 C는 한 덩어리로 등가속도 운동을 합니다. 실이 당기는 힘(장력)은 물체 하나만 따로 떼어 운동 방정식을 세우면 구할 수 있습니다. 문제의 조건에 맞게 질량과 기울기를 바꾸고, ‘일정한 속력이 되게 기울기 맞추기’를 누르면 오른쪽 빗면의 기울기가 세 물체가 등속도 운동을 하는 값으로 맞춰집니다.'] };
setupTabs(m => { mode = m; $('hintTxt').textContent = TEXT[m][0]; $('noteTxt').textContent = TEXT[m][1];
  if (m === 'incl'){ $('aS').value = 2; $('bS').value = 1; $('cS').value = 2; } else { $('aS').value = 1; $('bS').value = 4; }
  ['aS', 'bS', 'cS'].forEach(id => $(id).dispatchEvent(new Event('input'))); rs(); reset(); });
$('goB').addEventListener('click', () => { if (done) reset(); run = !run; $('goB').textContent = run ? '일시 정지' : '계속'; });
$('resetB').addEventListener('click', reset);
$('swapB').addEventListener('click', () => { const a = $('aS').value; $('aS').value = $('bS').value; $('bS').value = a; ['aS', 'bS'].forEach(id => $(id).dispatchEvent(new Event('input'))); });
$('balB').addEventListener('click', () => { const q = (+$('aS').value + +$('bS').value) * Math.sin(+$('lS').value * D) / +$('cS').value, a = Math.asin(Math.min(1, q)) / D;
  if (q > 1 || a > 60 || a < 15){ window.alert('이 질량과 왼쪽 기울기로는 15°~60° 안에서 맞출 수 없어요. C의 질량을 키우거나 왼쪽 기울기를 줄여 보세요.'); return; }
  $('rS').value = a.toFixed(1); $('rS').dispatchEvent(new Event('input')); });
$('cutB').addEventListener('click', () => { if (cut || done) return; cut = true; cutX = x; $('cutB').disabled = true; if (!run){ run = true; $('goB').textContent = '일시 정지'; } });
['aS', 'bS', 'cS', 'lS', 'rS', 'vS'].forEach(id => $(id).addEventListener('input', reset));
loop(draw);
