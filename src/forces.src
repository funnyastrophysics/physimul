힘의 합성과 빗면
  <h1>힘의 합성과 빗면</h1>
  <p class="hint" id="hintTxt"></p>
  <div class="card">
    <div class="tabs" id="tabs">
      <button data-m="sum">힘의 합성</button>
      <button data-m="slope">빗면 위의 물체</button>
    </div>
    <canvas id="sim" style="height:330px"></canvas>
    <div class="row m-sum">
      <label class="chk"><input type="checkbox" id="cPar" checked> 평행사변형</label>
      <label class="chk"><input type="checkbox" id="cEq"> 평형을 이루는 힘</label>
      <label class="chk"><input type="checkbox" id="cThird"> 세 번째 힘 추가</label>
    </div>
    <div class="fin m-sum" id="fin"></div>
    <div class="row m-slope">
      <button class="b primary" id="goB">놓기</button>
      <button class="b" id="resetB">처음으로</button>
      <label class="chk"><input type="checkbox" id="cComp" checked> 중력의 성분</label>
    </div>
    <div id="tbar" class="m-slope"></div>
    <div class="stats" id="stats"></div>
  </div>
  <div class="card">
    <div class="controls m-slope">
      <div class="sl"><div class="top"><span>빗면의 기울기 θ</span><b id="angV"></b></div>
        <input type="range" id="angS" min="0" max="60" step="1" value="30"><div class="range"><span>0°</span><span>60°</span></div></div>
      <div class="sl"><div class="top"><span>물체의 질량</span><b id="mV"></b></div>
        <input type="range" id="mS" min="1" max="10" step="0.5" value="2"><div class="range"><span>1 kg</span><span>10 kg</span></div></div>
      <div class="sl"><div class="top"><span>정지 마찰 계수</span><b id="musV"></b></div>
        <input type="range" id="musS" min="0" max="1" step="0.05" value="0.4"><div class="range"><span>0</span><span>1</span></div></div>
      <div class="sl"><div class="top"><span>운동 마찰 계수</span><b id="mukV"></b></div>
        <input type="range" id="mukS" min="0" max="1" step="0.05" value="0.3"><div class="range"><span>0</span><span>1</span></div></div>
    </div>
    <p class="note" id="noteTxt"></p>
  </div>
---CSS---
.fin{display:grid;gap:8px;margin-top:12px}
.fin .fr{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:15px}
.fin .fn{font-weight:700;width:26px}
.fin label{display:flex;align-items:center;gap:4px}
.fin input{font:inherit;font-weight:700;width:68px;padding:5px 6px;border:1.5px solid var(--line);border-radius:6px;text-align:right;font-variant-numeric:tabular-nums;-moz-appearance:textfield}
.fin input:focus{outline:none;border-color:var(--accent)}
.fin input::-webkit-outer-spin-button,.fin input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.fin .fnote{font-size:12px;color:var(--sub)}
---SCRIPT---
const g = 9.8, S = $('sim'); let s; const rs = () => { s = fitCanvas(S); }; window.addEventListener('resize', rs);
let mode;
bindLabels({ angS: ['angV', v => v + '°'], mS: ['mV', v => v.toFixed(1) + ' kg'], musS: ['musV', v => v.toFixed(2)], mukS: ['mukV', v => v.toFixed(2)] });

// ---------- 힘의 합성 (단위: N, 화면 1 N = k px) ----------
let F = [{ x: 4, y: 1, c: BLUE, n: 'F₁' }, { x: 1, y: 3.5, c: ORANGE, n: 'F₂' }, { x: -2, y: -2.5, c: GREEN, n: 'F₃' }], drag = -1, dragU = 0;
F.forEach(f => { f.a = Math.atan2(f.y, f.x); });
const shownF = () => $('cThird').checked ? F : F.slice(0, 2);
// 격자 1칸의 크기(N): 힘이 커지면 1 → 2 → 5 → 10 N으로 늘려 화면 안에 들어오게 한다. 끄는 동안에는 고정.
function gridUnit(){
  if (dragU) return dragU;
  const list = shownF(), R = list.reduce((a, f) => ({ x: a.x + f.x, y: a.y + f.y }), { x: 0, y: 0 });
  const ext = Math.max(...list.concat([R]).map(f => Math.max(Math.abs(f.x), Math.abs(f.y))));
  return [1, 2, 5, 10].find(u => ext / u <= 5.6) || 10;
}
function sumView(){ const { W, H } = s, u = gridUnit(); return { ox: W / 2, oy: H / 2 + 20, k: Math.min(W, H) / 13 / u, u }; }

// 크기·방향 직접 입력 (방향: +x축에서 시계 반대 방향으로 잰 각, 0°~360°)
const FMAX = 20;
$('fin').innerHTML = F.map((f, i) => '<div class="fr" data-i="' + i + '"><span class="fn" style="color:' + f.c + '">' + f.n + '</span>' +
  '<label>크기 <input type="number" data-k="r" min="0" max="' + FMAX + '" step="any" inputmode="decimal" aria-label="' + f.n + ' 크기(N)"> N</label>' +
  '<label>방향 <input type="number" data-k="a" min="0" max="360" step="any" inputmode="decimal" aria-label="' + f.n + ' 방향(도)"> °</label></div>').join('') +
  '<div class="fnote">방향은 +x축(오른쪽)에서 시계 반대 방향으로 잰 각입니다. 크기는 ' + FMAX + ' N까지.</div>';
const finRows = [...document.querySelectorAll('#fin .fr')];
const r2 = v => String(Math.round(v * 100) / 100);
const degOf = f => { let d = f.a * 180 / Math.PI % 360; if (d < 0) d += 360; return Math.round(d * 10) / 10 % 360; };
finRows.forEach((row, i) => {
  const [ri, ai] = row.querySelectorAll('input');
  const apply = () => { const r = parseFloat(ri.value), d = parseFloat(ai.value); if (!isFinite(r) || !isFinite(d)) return;
    const rr = Math.max(0, Math.min(FMAX, r)); F[i].a = d * Math.PI / 180; F[i].x = rr * Math.cos(F[i].a); F[i].y = rr * Math.sin(F[i].a); };
  [ri, ai].forEach(n => { n.addEventListener('input', apply); n.addEventListener('keydown', e => { if (e.key === 'Enter') n.blur(); }); n.addEventListener('blur', () => syncFin(true)); });
});
function syncFin(force){
  finRows.forEach((row, i) => { row.style.display = i < shownF().length ? '' : 'none';
    const [ri, ai] = row.querySelectorAll('input'), f = F[i];
    const rv = r2(Math.hypot(f.x, f.y)), av = String(degOf(f));
    if (force || document.activeElement !== ri){ if (ri.value !== rv) ri.value = rv; }
    if (force || document.activeElement !== ai){ if (ai.value !== av) ai.value = av; } });
}
function drawSum(){
  const { ctx, W, H } = s; ctx.clearRect(0, 0, W, H);
  const { ox, oy, k, u } = sumView(), list = shownF();
  // 격자 (1칸 = u N)
  ctx.strokeStyle = '#eef0f4'; ctx.lineWidth = 1;
  for (let i = -12; i <= 12; i++){ ctx.beginPath(); ctx.moveTo(ox + i * k * u, 0); ctx.lineTo(ox + i * k * u, H); ctx.stroke(); ctx.beginPath(); ctx.moveTo(0, oy + i * k * u); ctx.lineTo(W, oy + i * k * u); ctx.stroke(); }
  T(ctx, '격자 1칸 = ' + u + ' N, 화살표 끝을 끌어 보세요', 8, 12, { align: 'left', size: 11 });
  const R = list.reduce((a, f) => ({ x: a.x + f.x, y: a.y + f.y }), { x: 0, y: 0 });
  if ($('cPar').checked && list.length === 2){
    const [a, b] = list; line(ctx, [[ox + a.x * k, oy - a.y * k], [ox + R.x * k, oy - R.y * k]], b.c, 1.2, true); line(ctx, [[ox + b.x * k, oy - b.y * k], [ox + R.x * k, oy - R.y * k]], a.c, 1.2, true);
  }
  if ($('cPar').checked && list.length === 3){ // 꼬리에 머리를 잇기
    let px = 0, py = 0; list.forEach(f => { line(ctx, [[ox + px * k, oy - py * k], [ox + (px + f.x) * k, oy - (py + f.y) * k]], f.c, 1.2, true); px += f.x; py += f.y; });
  }
  list.forEach(f => { arrow(ctx, ox, oy, ox + f.x * k, oy - f.y * k, f.c, 3, 12); T(ctx, f.n, ox + f.x * k * 1.08 + 8, oy - f.y * k * 1.08, { color: f.c, bold: true, size: 14 }); ctx.fillStyle = f.c; ctx.globalAlpha = 0.18; ctx.beginPath(); ctx.arc(ox + f.x * k, oy - f.y * k, 16, 0, 7); ctx.fill(); ctx.globalAlpha = 1; });
  const Rm = Math.hypot(R.x, R.y);
  if (Rm > 0.05) arrow(ctx, ox, oy, ox + R.x * k, oy - R.y * k, PURPLE, 4, 14);
  if (Rm > 0.05) T(ctx, '합력', ox + R.x * k + 14, oy - R.y * k - 12, { color: PURPLE, bold: true, size: 14 });
  if ($('cEq').checked && Rm > 0.05){ arrow(ctx, ox, oy, ox - R.x * k, oy + R.y * k, RED, 3, 12); T(ctx, '평형을 이루는 힘', ox - R.x * k, oy + R.y * k + 16, { color: RED, bold: true }); }
  ctx.fillStyle = INK; ctx.beginPath(); ctx.arc(ox, oy, 6, 0, 7); ctx.fill();
  const ang = (Math.atan2(R.y, R.x) * 180 / Math.PI + 360) % 360;
  syncFin(false);
  setStats(list.map(f => [f.n + ' 크기', Math.hypot(f.x, f.y).toFixed(2) + ' N', f.c]).concat([['합력의 크기', Rm.toFixed(2) + ' N', PURPLE], ['합력의 방향', Rm > 0.05 ? '+x축에서 ' + fmt(ang, 0) + '°' : '-']]));
}
pointer(S, (x, y) => {
  if (mode !== 'sum') return false; const { ox, oy, k, u } = sumView(), list = shownF();
  drag = -1; let best = 30; list.forEach((f, i) => { const d = Math.hypot(ox + f.x * k - x, oy - f.y * k - y); if (d < best){ best = d; drag = i; } });
  if (drag < 0) return false; dragU = u; if (document.activeElement && document.activeElement.closest('#fin')) document.activeElement.blur();
}, (x, y) => { const { ox, oy, k, u } = sumView(), f = F[drag]; f.x = Math.round((x - ox) / k * 2 / u) / 2 * u; f.y = Math.round((oy - y) / k * 2 / u) / 2 * u;
  if (Math.hypot(f.x, f.y) > FMAX){ const q = FMAX / Math.hypot(f.x, f.y); f.x *= q; f.y *= q; }
  if (f.x || f.y) f.a = Math.atan2(f.y, f.x); }, () => { dragU = 0; });

// ---------- 빗면 ----------
let pos = 0, vel = 0, run = false;
function drawSlope(dt){
  const { ctx, W, H } = s; ctx.clearRect(0, 0, W, H);
  const th = +$('angS').value * Math.PI / 180, m = +$('mS').value, mus = +$('musS').value, muk = +$('mukS').value;
  const Fg = m * g, Fpar = Fg * Math.sin(th), N = Fg * Math.cos(th), fsMax = mus * N;
  const moving = Math.abs(vel) > 1e-6 || (run && Fpar > fsMax + 1e-9);
  let fric, a;
  if (moving){ fric = muk * N; a = (Fpar - fric) / m; } else { fric = Math.min(Fpar, fsMax); a = 0; }
  if (run && moving){ vel = Math.max(0, vel + a * dt); pos += vel * dt; if (vel <= 0 && Fpar <= fsMax) vel = 0; }
  // 그리기
  const Lpx = Math.min(W * 0.85, (H - 70) / Math.max(0.3, Math.sin(th)) * 0.9, W * 0.85), x0 = W - 20, y0 = H - 30;
  const topX = x0 - Lpx * Math.cos(th), topY = y0 - Lpx * Math.sin(th);
  ctx.fillStyle = '#e6e9ef'; ctx.beginPath(); ctx.moveTo(topX, topY); ctx.lineTo(x0, y0); ctx.lineTo(topX, y0); ctx.closePath(); ctx.fill();
  line(ctx, [[topX, topY], [x0, y0], [topX - 10, y0]], INK, 2); line(ctx, [[topX, topY], [topX, y0]], INK, 1);
  if (th > 0.02){ ctx.strokeStyle = INK; ctx.lineWidth = 1; ctx.beginPath(); ctx.arc(x0, y0, 34, Math.PI, Math.PI + th); ctx.stroke(); T(ctx, 'θ', x0 - 44, y0 - 10, { color: INK, bold: true }); }
  const d = Math.min(Lpx - 30, 40 + pos * 60), ux = Math.cos(th), uy = Math.sin(th);
  const bx = topX + d * ux, by = topY + d * uy, size = 26 + m * 2;
  ctx.save(); ctx.translate(bx, by); ctx.rotate(th); ctx.fillStyle = '#5a6478'; ctx.fillRect(-size / 2, -size, size, size); ctx.restore();
  const cx = bx + size / 2 * uy, cy = by - size / 2 * ux, k = 80 / Math.sqrt(Fg * 19.6);   // 화살표 길이는 힘에 비례
  arrow(ctx, cx, cy, cx, cy + Fg * k, RED, 3); T(ctx, '중력 ' + Fg.toFixed(1) + ' N', cx + 6, cy + Fg * k + 10, { color: RED, bold: true, align: 'left', size: 11 });
  if ($('cComp').checked && th > 0.02){
    arrow(ctx, cx, cy, cx + Fpar * k * ux, cy + Fpar * k * uy, RED, 1.8); arrow(ctx, cx, cy, cx - N * k * uy, cy + N * k * ux, RED, 1.8);
    line(ctx, [[cx + Fpar * k * ux, cy + Fpar * k * uy], [cx, cy + Fg * k]], RED, 1, [3, 3]); line(ctx, [[cx - N * k * uy, cy + N * k * ux], [cx, cy + Fg * k]], RED, 1, [3, 3]);
  }
  arrow(ctx, cx, cy, cx + N * k * uy, cy - N * k * ux, BLUE, 3); T(ctx, '수직 항력', cx + N * k * uy + 6, cy - N * k * ux - 8, { color: BLUE, bold: true, size: 11, align: 'left' });
  if (fric > 0.01){ arrow(ctx, cx, cy, cx - fric * k * ux, cy - fric * k * uy, GREEN, 3); T(ctx, (moving ? '운동' : '정지') + ' 마찰력', cx - fric * k * ux - 4, cy - fric * k * uy - 12, { color: GREEN, bold: true, size: 11, align: 'right' }); }
  const state = !run ? '[놓기]를 누르세요' : moving ? '미끄러져 내려갑니다' : '정지해 있습니다 (중력의 빗면 성분 ≤ 최대 정지 마찰력)';
  T(ctx, state, 10, 14, { align: 'left', bold: true, color: moving ? ORANGE : INK, size: 12 });
  if (d >= Lpx - 31) run = false;
  setStats([['중력의 빗면 방향 성분', Fpar.toFixed(1) + ' N', RED], ['수직 항력', N.toFixed(1) + ' N', BLUE], ['최대 정지 마찰력', fsMax.toFixed(1) + ' N', GREEN], ['알짜힘', (moving ? Fpar - muk * N : 0).toFixed(1) + ' N'], ['가속도', gAcc(moving ? a : 0), ORANGE]]);
}
const TEXT = {
  sum: ['화살표 끝을 끌거나 그림 아래 칸에 크기와 방향을 입력해 두 힘을 바꾸고, 합력이 어떻게 정해지는지 관찰하세요.',
    '두 힘의 합력은 두 힘을 이웃한 변으로 하는 평행사변형의 대각선입니다. 여러 힘은 화살표를 꼬리에 머리를 잇듯 이어 붙여 더할 수 있습니다. 합력과 크기가 같고 방향이 반대인 힘을 더하면 알짜힘이 0이 되어 물체는 평형을 이룹니다.'],
  slope: ['빗면의 기울기와 마찰 계수를 바꾸며 물체에 작용하는 힘을 분석하세요. 중력을 빗면에 나란한 성분과 수직인 성분으로 나누면 운동을 예측할 수 있습니다.',
    '중력의 빗면 방향 성분은 mg sinθ, 수직 성분은 mg cosθ이며 수직 항력과 크기가 같습니다. 중력의 빗면 방향 성분이 최대 정지 마찰력(μₛN)보다 크면 물체가 미끄러지고, 그때 가속도는 (mg sinθ − μₖN)/m입니다. 화살표 길이는 힘의 크기에 비례합니다.'] };
setupTabs(m => { mode = m; $('hintTxt').textContent = TEXT[m][0]; $('noteTxt').textContent = TEXT[m][1]; rs(); });
let clock = null;
const reset = () => { pos = 0; vel = 0; run = false; if (clock) clock.zero(); };
$('goB').addEventListener('click', () => { reset(); run = true; vel = 0; });
$('resetB').addEventListener('click', reset);
['angS', 'mS', 'musS', 'mukS'].forEach(id => $(id).addEventListener('input', reset));
clock = loopT(dt => mode === 'sum' ? drawSum() : drawSlope(dt), { reset, start: () => { run = true; vel = 0; }, active: () => mode === 'slope' && run, visible: () => mode === 'slope' });
