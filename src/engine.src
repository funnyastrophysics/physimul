열기관의 순환 과정
  <h1>열기관의 순환 과정과 열효율</h1>
  <p class="hint">기체가 압력–부피 그래프 위의 닫힌 경로를 한 바퀴 돌 때마다, 고열원에서 열을 받아 일부를 일로 바꾸고 나머지는 저열원으로 버립니다. 순환 과정의 모양을 바꾸며 열효율을 비교하세요.</p>
  <div class="card">
    <div class="row" style="margin-top:0">
      <select id="cycS"><option value="rect">등압·등적 과정으로 된 순환</option><option value="stir">스털링 기관 (등온·등적 과정)</option></select>
      <button class="b primary" id="goB">멈춤</button>
    </div>
    <canvas id="sim" style="height:300px;margin-top:10px"></canvas>
    <div class="stats" id="stats"></div>
  </div>
  <div class="card"><canvas id="flow" style="height:190px"></canvas></div>
  <div class="card">
    <div class="controls">
      <div class="sl"><div class="top"><span id="hiL">높은 압력</span><b id="hiV"></b></div>
        <input type="range" id="hiS" min="150" max="400" step="10" value="300"><div class="range"><span id="hiA"></span><span id="hiB"></span></div></div>
      <div class="sl"><div class="top"><span id="loL">낮은 압력</span><b id="loV"></b></div>
        <input type="range" id="loS" min="50" max="140" step="10" value="100"><div class="range"><span id="loA"></span><span id="loB"></span></div></div>
      <div class="sl"><div class="top"><span>부피 변화 범위</span><b id="vV"></b></div>
        <input type="range" id="vS" min="30" max="60" step="2" value="50"><div class="range"><span>20 → 30 mL</span><span>20 → 60 mL</span></div></div>
    </div>
    <p class="note">기체가 한 일은 그래프로 둘러싸인 넓이와 같고, 열효율 = (한 일) ÷ (고열원에서 받은 열)입니다. 버리는 열이 0이 될 수 없으므로 열효율은 항상 1(100 %)보다 작습니다. 따라서 받은 열을 모두 일로 바꾸는 기관이나, 에너지 공급 없이 계속 움직이는 영구 기관은 만들 수 없습니다. (단원자 이상 기체 기준, 기체를 데우고 식힐 때의 열을 모두 외부와 주고받는다고 가정)</p>
  </div>
---SCRIPT---
const R = 8.31, S = $('sim'), F = $('flow'); let s, f; const rs = () => { s = fitCanvas(S); f = fitCanvas(F); }; window.addEventListener('resize', rs);
let ph = 0, run = true;
function labels(){
  const st = $('cycS').value === 'stir';
  $('hiL').textContent = st ? '고열원의 온도' : '높은 압력'; $('loL').textContent = st ? '저열원의 온도' : '낮은 압력';
  if (st){ $('hiS').min = 400; $('hiS').max = 900; $('hiS').step = 10; $('loS').min = 250; $('loS').max = 390; }
  else { $('hiS').min = 150; $('hiS').max = 400; $('loS').min = 50; $('loS').max = 140; }
  $('hiV').textContent = $('hiS').value + (st ? ' K' : ' kPa'); $('loV').textContent = $('loS').value + (st ? ' K' : ' kPa');
  $('hiA').textContent = $('hiS').min + (st ? ' K' : ' kPa'); $('hiB').textContent = $('hiS').max + (st ? ' K' : ' kPa');
  $('loA').textContent = $('loS').min + (st ? ' K' : ' kPa'); $('loB').textContent = $('loS').max + (st ? ' K' : ' kPa');
  $('vV').textContent = '20 → ' + $('vS').value + ' mL';
}
$('cycS').addEventListener('change', () => { if ($('cycS').value === 'stir'){ $('hiS').value = 600; $('loS').value = 300; } else { $('hiS').value = 300; $('loS').value = 100; } labels(); });
['hiS', 'loS', 'vS'].forEach(id => $(id).addEventListener('input', labels));
$('goB').addEventListener('click', () => { run = !run; $('goB').textContent = run ? '멈춤' : '계속'; });
// 경로: [{pts:[[V(mL),P(kPa)],...], name, Q(J)}]
function cycle(){
  const V1 = 20, V2 = +$('vS').value, st = $('cycS').value === 'stir';
  if (!st){
    const P1 = +$('hiS').value, P2 = +$('loS').value, k = 1e-3;   // kPa·mL = mJ → ×1e-3 J
    return [
      { name: '등압 팽창', pts: [[V1, P1], [V2, P1]], Q: 2.5 * P1 * (V2 - V1) * k },
      { name: '등적 냉각', pts: [[V2, P1], [V2, P2]], Q: -1.5 * V2 * (P1 - P2) * k },
      { name: '등압 압축', pts: [[V2, P2], [V1, P2]], Q: -2.5 * P2 * (V2 - V1) * k },
      { name: '등적 가열', pts: [[V1, P2], [V1, P1]], Q: 1.5 * V1 * (P1 - P2) * k } ];
  }
  const Th = +$('hiS').value, Tc = +$('loS').value, n = 0.002, iso = (T, a, b) => { const p = []; for (let i = 0; i <= 30; i++){ const V = a + (b - a) * i / 30; p.push([V, n * R * T / (V * 1e-6) / 1000]); } return p; };
  return [
    { name: '등온 팽창', pts: iso(Th, V1, V2), Q: n * R * Th * Math.log(V2 / V1) },
    { name: '등적 냉각', pts: [[V2, n * R * Th / (V2 * 1e-6) / 1000], [V2, n * R * Tc / (V2 * 1e-6) / 1000]], Q: -1.5 * n * R * (Th - Tc) },
    { name: '등온 압축', pts: iso(Tc, V2, V1), Q: -n * R * Tc * Math.log(V2 / V1) },
    { name: '등적 가열', pts: [[V1, n * R * Tc / (V1 * 1e-6) / 1000], [V1, n * R * Th / (V1 * 1e-6) / 1000]], Q: 1.5 * n * R * (Th - Tc) } ];
}
function pointAt(c, u){ // u: 0~4
  const i = Math.min(3, Math.floor(u)), seg = c[i].pts, f = u - i, x = f * (seg.length - 1), j = Math.min(seg.length - 2, Math.floor(x)), g = x - j;
  return [seg[j][0] + (seg[j + 1][0] - seg[j][0]) * g, seg[j][1] + (seg[j + 1][1] - seg[j][1]) * g, i];
}
loop(dt => {
  const c = cycle(); if (run) ph = (ph + dt * 0.8) % 4;
  const Qin = c.filter(x => x.Q > 0).reduce((a, x) => a + x.Q, 0), Qout = -c.filter(x => x.Q < 0).reduce((a, x) => a + x.Q, 0), Wn = Qin - Qout, eff = Wn / Qin;
  const { ctx, W, H } = s; ctx.clearRect(0, 0, W, H);
  const split = W > 520 ? W * 0.62 : W, pmax = Math.max(...c.flatMap(x => x.pts.map(p => p[1])));
  const A = axes(ctx, split, W > 520 ? H : H * 0.72, { x0: 0, x1: 70, y0: 0, y1: niceMax(pmax * 1.1), xt: [0, 10, 20, 30, 40, 50, 60, 70], yt: [0, 0.25, 0.5, 0.75, 1].map(v => Math.round(v * niceMax(pmax * 1.1))), xl: '부피 (mL)', yl: '압력 (kPa)' });
  ctx.fillStyle = 'rgba(47,111,223,0.15)'; ctx.beginPath(); c.forEach(x => x.pts.forEach((p, i) => ctx.lineTo(A.X(p[0]), A.Y(p[1])))); ctx.closePath(); ctx.fill();
  c.forEach(x => { ctx.strokeStyle = x.Q > 0 ? RED : BLUE; ctx.lineWidth = 3; ctx.beginPath(); x.pts.forEach((p, i) => i ? ctx.lineTo(A.X(p[0]), A.Y(p[1])) : ctx.moveTo(A.X(p[0]), A.Y(p[1]))); ctx.stroke();
    const a0 = x.pts[0], a1 = x.pts[x.pts.length - 1], mid = x.pts[Math.floor((x.pts.length - 1) / 2)], nx = x.pts.length > 2 ? x.pts[Math.floor((x.pts.length - 1) / 2) + 1] : a1;
    const mx = x.pts.length > 2 ? A.X(mid[0]) : (A.X(a0[0]) + A.X(a1[0])) / 2, my = x.pts.length > 2 ? A.Y(mid[1]) : (A.Y(a0[1]) + A.Y(a1[1])) / 2;
    let dx = A.X(nx[0]) - A.X(mid[0]), dy = A.Y(nx[1]) - A.Y(mid[1]); if (x.pts.length === 2){ dx = A.X(a1[0]) - A.X(a0[0]); dy = A.Y(a1[1]) - A.Y(a0[1]); }
    const L = Math.hypot(dx, dy) || 1; arrow(ctx, mx - dx / L * 8, my - dy / L * 8, mx + dx / L * 8, my + dy / L * 8, x.Q > 0 ? RED : BLUE, 3, 12); });
  const [pv, pp, si] = pointAt(c, ph);
  ctx.fillStyle = INK; ctx.beginPath(); ctx.arc(A.X(pv), A.Y(pp), 7, 0, 7); ctx.fill();
  T(ctx, '빨강: 열을 받는 과정, 파랑: 열을 버리는 과정', A.L + 6, A.top + 10, { align: 'left', size: 11 });
  T(ctx, '지금: ' + c[si].name, A.L + 6, A.top + 26, { align: 'left', size: 12, bold: true, color: c[si].Q > 0 ? RED : BLUE });
  // 실린더
  const cx0 = W > 520 ? split + 30 : 30, cy0 = W > 520 ? 40 : H * 0.76, cw = W > 520 ? W - split - 50 : W - 60, chh = W > 520 ? 70 : H * 0.2;
  const fill = pv / 70; ctx.fillStyle = c[si].Q > 0 ? 'rgba(214,69,65,0.18)' : 'rgba(47,111,223,0.18)'; ctx.fillRect(cx0, cy0, cw * fill, chh);
  ctx.strokeStyle = INK; ctx.lineWidth = 2.5; ctx.beginPath(); ctx.moveTo(cx0 + cw, cy0); ctx.lineTo(cx0, cy0); ctx.lineTo(cx0, cy0 + chh); ctx.lineTo(cx0 + cw, cy0 + chh); ctx.stroke();
  ctx.fillStyle = GRAY; ctx.fillRect(cx0 + cw * fill, cy0 + 2, 10, chh - 4); ctx.fillRect(cx0 + cw * fill + 10, cy0 + chh / 2 - 3, cw * (1 - fill) + 10, 6);
  T(ctx, '실린더 속 기체', cx0 + 6, cy0 - 8, { align: 'left', size: 11 });
  setStats([['받은 열 Q₁', Qin.toFixed(2) + ' J', RED], ['버린 열 Q₂', Qout.toFixed(2) + ' J', BLUE], ['한 일 W = Q₁ − Q₂', Wn.toFixed(2) + ' J', PURPLE], ['열효율', (eff * 100).toFixed(1) + ' %', INK]]);
  // 에너지 흐름도
  const { ctx: c2, W: FW, H: FH } = f; c2.clearRect(0, 0, FW, FH);
  const cxm = FW * 0.42, ey = FH / 2, w1 = 34, wW = Math.max(3, w1 * eff), wQ = Math.max(3, w1 * (1 - eff));
  const box = (x, y, w, h, col, t) => { c2.fillStyle = col; c2.fillRect(x - w / 2, y - h / 2, w, h); T(c2, t, x, y, { color: '#fff', bold: true, size: 12 }); };
  c2.globalAlpha = 0.85;
  arrow(c2, cxm, 30, cxm, ey - 16, RED, w1, w1 * 0.9); arrow(c2, cxm - w1 / 2 + wQ / 2, ey + 14, cxm - w1 / 2 + wQ / 2, FH - 28, BLUE, wQ, Math.max(10, wQ * 1.2)); arrow(c2, cxm + 40, ey, FW - 24, ey, PURPLE, wW, Math.max(10, wW * 1.3));
  c2.globalAlpha = 1;
  box(cxm, 16, 120, 26, RED, '고열원'); box(cxm, ey, 92, 30, INK, '열기관'); box(cxm, FH - 14, 120, 26, BLUE, '저열원');
  T(c2, 'Q₁ 100%', cxm + w1 / 2 + 6, (30 + ey) / 2, { align: 'left', bold: true, color: RED });
  T(c2, 'Q₂ ' + Math.round((1 - eff) * 100) + '%', cxm + 10, (ey + FH) / 2 + 4, { align: 'left', bold: true, color: BLUE });
  T(c2, '일 W ' + Math.round(eff * 100) + '%', FW - 24, ey - wW / 2 - 12, { align: 'right', bold: true, color: PURPLE });
});
labels(); rs();
