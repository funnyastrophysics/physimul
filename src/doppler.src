도플러 효과
  <h1>도플러 효과</h1>
  <p class="hint">움직이는 음원에서 나온 소리의 파면을 관찰하세요. 음원 앞쪽은 파면이 촘촘해지고 뒤쪽은 성겨집니다. 초록색 관찰자를 끌어 옮기고 '소리 듣기'를 누르면 관찰자에게 들리는 소리를 직접 들을 수 있습니다.</p>
  <div class="card">
    <canvas id="sim" style="height:320px;background:#fbfcfd;border-radius:8px"></canvas>
    <div class="row">
      <button class="b primary" id="sndB">소리 듣기</button>
      <button class="b" id="resetB">처음부터</button>
      <label class="chk"><input type="checkbox" id="cPause"> 멈춤</label>
    </div>
    <div class="stats" id="stats"></div>
  </div>
  <div class="card">
    <div class="controls">
      <div class="sl"><div class="top"><span>음원의 속력 v<sub>s</sub></span><b id="vsV"></b></div>
        <input type="range" id="vsS" min="0" max="1.4" step="0.05" value="0.4"><div class="range"><span>정지</span><span>음속의 1.4배</span></div></div>
      <div class="sl"><div class="top"><span>음원의 진동수 f</span><b id="fV"></b></div>
        <input type="range" id="fS" min="300" max="1000" step="10" value="500"><div class="range"><span>300 Hz</span><span>1000 Hz</span></div></div>
    </div>
    <p class="note">음원이 관찰자에게 다가오면 관찰자에게 도달하는 파면 사이의 간격(파장)이 짧아져 원래보다 높은 진동수의 소리가 들리고, 멀어지면 낮은 소리가 들립니다. 정지한 관찰자가 듣는 진동수는 f' = f·v/(v ∓ v<sub>s</sub>)입니다(다가올 때 −, 멀어질 때 +, v는 음속 340 m/s). 음원의 속력이 음속보다 빠르면 파면이 겹쳐 원뿔 모양의 충격파가 생깁니다. 구급차 사이렌, 스피드건, 별의 적색 편이 등에 이용됩니다.</p>
  </div>
---SCRIPT---
const V = 340, S = $('sim'); let s; const rs = () => { s = fitCanvas(S); }; window.addEventListener('resize', rs); rs();
bindLabels({ vsS: ['vsV', v => (v * V).toFixed(0) + ' m/s (' + v.toFixed(2) + 'v)'], fS: ['fV', v => v + ' Hz'] });
let fronts = [], t = 0, lastEmit = -1, sx = 0, obs = { fx: 0.5, fy: 0.82 }, snd = null, started = false;
const P = 0.32;   // 화면에서 파면을 그리는 시간 간격(실제 주기 대신 일정한 간격으로 표시)
const cpx = () => Math.min(s.W, s.H) * 0.42;   // 화면에서 음속 (px/s)
function reset(){ fronts = []; t = 0; lastEmit = -1; const vs = +$('vsS').value; sx = vs < 0.01 ? s.W / 2 : -s.W * 0.05; }
function fAt(px, py){ const vs = +$('vsS').value, f = +$('fS').value; if (vs < 0.01) return f;
  const dx = px - sx, dy = py - s.H * 0.42, d = Math.hypot(dx, dy) || 1, c = dx / d;   // 음원 속도 방향과 관찰자 방향의 코사인
  const den = 1 - vs * c; return den <= 0.05 ? null : f / den; }
function draw(dt){
  const { ctx, W, H } = s; ctx.clearRect(0, 0, W, H); const vs = +$('vsS').value, cy = H * 0.42, c = cpx();
  if (!started){ started = true; reset(); }
  if (!$('cPause').checked){ t += dt; sx += vs * c * dt;
    if (t - lastEmit >= P){ lastEmit = t; fronts.push({ x: sx, t0: t }); }
    if (sx > W * 1.15) reset(); }
  fronts = fronts.filter(fr => (t - fr.t0) * c < Math.hypot(W, H) * 1.2);
  ctx.lineWidth = 1.5;
  for (const fr of fronts){ const r = (t - fr.t0) * c, a = Math.max(0.15, 1 - r / (Math.hypot(W, H) * 1.1)); ctx.strokeStyle = `rgba(46,111,219,${a})`; ctx.beginPath(); ctx.arc(fr.x, cy, r, 0, 7); ctx.stroke(); }
  // 음원 (자동차)
  ctx.fillStyle = RED; ctx.beginPath(); ctx.roundRect ? ctx.roundRect(sx - 16, cy - 9, 32, 18, 5) : ctx.rect(sx - 16, cy - 9, 32, 18); ctx.fill();
  T(ctx, '음원', sx, cy - 16, { color: RED, bold: true, size: 12 });
  if (vs > 0.01) arrow(ctx, sx + 18, cy, sx + 18 + 26 + vs * 22, cy, RED, 2, 7);
  // 앞·뒤 관찰자
  const fF = vs >= 1 ? null : +$('fS').value / (1 - vs), fB = +$('fS').value / (1 + vs);
  const ear = (x, lab, col) => { ctx.fillStyle = col; ctx.beginPath(); ctx.arc(x, cy, 7, 0, 7); ctx.fill(); T(ctx, lab, x, cy + 22, { color: col, bold: true, size: 11 }); };
  ear(W - 14, '앞', ORANGE); ear(14, '뒤', PURPLE);
  // 움직일 수 있는 관찰자
  const ox = obs.fx * W, oy = obs.fy * H, fo = fAt(ox, oy);
  ctx.fillStyle = 'rgba(46,158,106,0.18)'; ctx.beginPath(); ctx.arc(ox, oy, 20, 0, 7); ctx.fill();
  ctx.fillStyle = GREEN; ctx.beginPath(); ctx.arc(ox, oy, 9, 0, 7); ctx.fill();
  T(ctx, '관찰자 (끌기)', ox, oy + 30 > H - 4 ? oy - 26 : oy + 32, { color: GREEN, bold: true, size: 11 });
  if (vs >= 1) T(ctx, '음원이 음속보다 빠름 → 충격파', W / 2, 18, { color: RED, bold: true, size: 13 });
  if (snd){ if (fo) snd.set(fo, 0.18); else snd.set(+$('fS').value, 0); }
  const fm = v => v ? v.toFixed(0) + ' Hz' : '—';
  setStats([['앞쪽 관찰자', fm(fF), ORANGE], ['뒤쪽 관찰자', fm(fB), PURPLE], ['초록 관찰자', fo ? fm(fo) : '충격파 전', GREEN], ['음원의 진동수', fm(+$('fS').value)]]);
}
pointer(S, (x, y) => { if (Math.hypot(x - obs.fx * s.W, y - obs.fy * s.H) > 36) return false; }, (x, y) => { obs.fx = Math.min(0.97, Math.max(0.03, x / s.W)); obs.fy = Math.min(0.97, Math.max(0.03, y / s.H)); });
$('vsS').addEventListener('input', reset); $('resetB').addEventListener('click', reset);
window.addEventListener('resize', reset);
$('sndB').addEventListener('click', () => { if (snd){ snd.stop(); snd = null; $('sndB').textContent = '소리 듣기'; } else { snd = tone(); $('sndB').textContent = '소리 끄기'; } });
loop(draw);
