등가 원리와 블랙홀
  <h1>등가 원리와 블랙홀</h1>
  <p class="hint" id="hintTxt"></p>
  <div class="card">
    <div class="tabs" id="tabs">
      <button data-m="ball">공 놓기</button>
      <button data-m="light">빛의 진행</button>
      <button data-m="bh">블랙홀</button>
    </div>
    <canvas id="sim" style="height:320px;border-radius:8px;background:#141a28"></canvas>
    <div class="row m-ball"><select id="sitS"><option value="g">지표면의 방 ↔ 가속하는 우주선</option><option value="free">자유 낙하하는 방 ↔ 우주에 떠 있는 우주선</option></select>
      <button class="b primary" id="dropB">공 놓기</button></div>
    <div class="stats" id="stats"></div>
  </div>
  <div class="card">
    <div class="sl m-light"><div class="top"><span>중력 가속도와 우주선의 가속도 (과장)</span><b id="aV"></b></div>
      <input type="range" id="aS" min="0" max="100" step="5" value="60"><div class="range"><span>0</span><span>매우 큼</span></div></div>
    <div class="sl m-bh"><div class="top"><span>천체의 반지름 (질량은 태양과 같음)</span><b id="rV"></b></div>
      <input type="range" id="rS" min="0" max="100" step="1" value="0"><div class="range"><span>태양 크기</span><span>아주 작게 압축</span></div></div>
    <p class="note" id="noteTxt"></p>
  </div>
---SCRIPT---
const S = $('sim'); let s; const rs = () => { s = fitCanvas(S); }; window.addEventListener('resize', rs);
let mode, tDrop = -1, t = 0, stars = Array.from({ length: 40 }, () => [Math.random(), Math.random()]), cl1 = 0, cl2 = 0;
const PALE = '#c9d2e3', DIM = '#8d97aa', LIGHT = '#ffe58a';
const RS = 2.95, R0 = 6.96e5;   // 태양 질량의 슈바르츠실트 반지름, 태양 반지름 (km)
const Rkm = u => R0 * Math.pow(10, -u / 100 * 5.67);
const kmTxt = R => R >= 10000 ? Math.round(R / 10000).toLocaleString('ko-KR') + '만 km' : R >= 100 ? Math.round(R).toLocaleString('ko-KR') + ' km' : fmt(R, 1) + ' km';
bindLabels({ aS: ['aV', v => v === 0 ? '0' : v + ' %'], rS: ['rV', v => kmTxt(Rkm(v))] });
function person(ctx, x, yFloor, hand){
  ctx.strokeStyle = PALE; ctx.lineWidth = 2; ctx.beginPath(); ctx.arc(x, yFloor - 62, 7, 0, 7); ctx.stroke();
  line(ctx, [[x, yFloor - 55], [x, yFloor - 26]], PALE, 2); line(ctx, [[x - 7, yFloor], [x, yFloor - 26], [x + 7, yFloor]], PALE, 2); line(ctx, [[x, yFloor - 48], [hand[0], hand[1]]], PALE, 2); }
// 방 두 개의 공통 틀. 반환: 방의 좌표
function rooms(ctx, W, H, labels, rocketFlame, starSpeed, leftKind, dt){
  const rw = W * 0.4, rh = 170, y0 = 62, xs = [W * 0.06, W * 0.54];
  // 오른쪽: 우주 배경
  stars.forEach(p => { p[1] = (p[1] + starSpeed * dt) % 1; ctx.fillStyle = 'rgba(255,255,255,0.7)'; ctx.fillRect(W * 0.5 + p[0] * W * 0.5, p[1] * (H - 40), 1.5, 1.5); });
  // 왼쪽: 지구 배경
  ctx.fillStyle = '#1d2a3f'; ctx.fillRect(0, 0, W * 0.5, H - 40);
  if (leftKind === 'ground'){ ctx.fillStyle = '#2e6b4a'; ctx.fillRect(0, y0 + rh + 4, W * 0.5, H - 40 - y0 - rh - 4); }
  else for (let k = 0; k < 6; k++){ const yy = (H - 40) - ((t * 140 + k * 60) % (H - 40)); ctx.fillStyle = 'rgba(255,255,255,0.25)'; ctx.fillRect(4 + (k % 2) * (W * 0.5 - 14), yy, 6, 26); }
  line(ctx, [[W * 0.5, 0], [W * 0.5, H - 40]], '#0c1120', 2);
  xs.forEach((x, k) => {
    ctx.fillStyle = '#263048'; ctx.fillRect(x, y0, rw, rh); ctx.strokeStyle = PALE; ctx.lineWidth = 2; ctx.strokeRect(x, y0, rw, rh);
    T(ctx, labels[k][0], x + rw / 2, 20, { color: PALE, bold: true }); T(ctx, labels[k][1], x + rw / 2, 40, { color: DIM, size: 11 }); });
  if (rocketFlame){ const x = xs[1], f = 14 + 8 * Math.sin(t * 30); ctx.fillStyle = ORANGE; ctx.beginPath(); ctx.moveTo(x + rw * 0.3, y0 + rh + 2); ctx.lineTo(x + rw / 2, y0 + rh + 2 + f + 16); ctx.lineTo(x + rw * 0.7, y0 + rh + 2); ctx.fill();
    arrow(ctx, x + rw + 10, y0 + rh * 0.65, x + rw + 10, y0 + rh * 0.35, ORANGE, 2.5, 8); }
  return { xs, rw, rh, y0 };
}
function drawBall(dt){
  const { ctx, W, H } = s, free = $('sitS').value === 'free';
  const R = rooms(ctx, W, H, free ? [['자유 낙하하는 방', '줄이 끊어진 승강기'], ['떠 있는 우주선', '중력이 없는 우주 공간']] : [['지표면에 정지한 방', '아래로 중력이 작용'], ['가속하는 우주선', '중력이 없는 우주 공간']], !free, free ? 0 : 0.25, free ? 'fall' : 'ground', dt);
  const yF = R.y0 + R.rh, hy = yF - 96, fall = yF - 7 - hy;
  let dy = 0; if (tDrop >= 0){ tDrop += dt; dy = free ? 0 : Math.min(fall, 0.5 * 420 * tDrop * tDrop); }
  R.xs.forEach(x => { const px = x + R.rw * 0.35, bx = x + R.rw * 0.62; person(ctx, px, yF, [bx - 6, hy + 4]);
    ctx.fillStyle = RED; ctx.beginPath(); ctx.arc(bx, hy + dy, 7, 0, 7); ctx.fill();
    if (tDrop >= 0 && !free && dy < fall) arrow(ctx, bx + 14, hy + dy - 10, bx + 14, hy + dy + 14, RED, 2, 6); });
  T(ctx, free ? '두 방 모두 공이 손 옆에 그대로 떠 있다' : '두 방 모두 공이 같은 가속도로 바닥에 떨어진다', W / 2, H - 20, { color: LIGHT, bold: true, size: 12 });
  setStats(free ? [['방 안에서 본 공', '떠 있음'], ['몸무게', '느껴지지 않음'], ['두 방의 구별', '할 수 없음', ORANGE]] : [['방 안에서 본 공의 가속도', '둘 다 9.8 m/s²'], ['몸무게', '똑같이 느껴짐'], ['두 방의 구별', '할 수 없음', ORANGE]]);
}
function drawLight(dt){
  const { ctx, W, H } = s, a = +$('aS').value / 100;
  const R = rooms(ctx, W, H, [['지표면에 정지한 방', '아래로 중력이 작용'], ['가속하는 우주선', '중력이 없는 우주 공간']], a > 0, 0.25 * a, 'ground', dt);
  const y1 = R.y0 + 40, drop = 100 * a, ph = (t * 0.7) % 1.3;
  R.xs.forEach(x => {
    ctx.fillStyle = PALE; ctx.fillRect(x - 3, y1 - 6, 12, 12);
    line(ctx, [[x + 9, y1], [x + R.rw, y1]], 'rgba(201,210,227,0.35)', 1, [3, 4]);
    const pts = []; for (let u = 0; u <= Math.min(1, ph) + 1e-9; u += 0.02) pts.push([x + 9 + (R.rw - 9) * u, y1 + drop * u * u]);
    if (pts.length > 1) line(ctx, pts, LIGHT, 2.5);
    const u = Math.min(1, ph); ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(x + 9 + (R.rw - 9) * u, y1 + drop * u * u, 4, 0, 7); ctx.fill(); });
  T(ctx, a > 0 ? '두 방 모두 빛이 아래로 휘어진다' : '가속도가 0이면 빛은 직진한다', W / 2, H - 20, { color: LIGHT, bold: true, size: 12 });
  setStats([['우주선 안에서 본 빛', a > 0 ? '아래로 휘어짐' : '직진'], ['등가 원리에 따르면', a > 0 ? '중력도 빛을 휘게 함' : '—', ORANGE], ['점선', '직진할 때의 경로']]);
}
function hand(ctx, x, y, r, ang, lab, rate){
  ctx.fillStyle = '#263048'; ctx.strokeStyle = PALE; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(x, y, r, 0, 7); ctx.fill(); ctx.stroke();
  line(ctx, [[x, y], [x + Math.sin(ang) * r * 0.8, y - Math.cos(ang) * r * 0.8]], LIGHT, 2.5); T(ctx, lab, x, y + r + 13, { color: PALE, size: 11 }); T(ctx, rate, x, y + r + 28, { color: LIGHT, size: 11, bold: true }); }
function drawBh(dt){
  const { ctx, W, H } = s, R = Rkm(+$('rS').value), comp = RS / R, bh = comp >= 1;
  stars.forEach(p => { ctx.fillStyle = 'rgba(255,255,255,0.5)'; ctx.fillRect(p[0] * W, p[1] * H, 1.5, 1.5); });
  const cx = W / 2, cy = 120, rp = 22;
  // 빛의 경로 (천체 반지름을 같은 크기로 그리고 휘는 정도만 비교)
  const K = Math.min(comp, 1.2) * rp * 1.1;
  for (const b of [-88, -62, -40, 40, 62, 88]){
    let x = 0, y = cy + b, vx = 1, vy = 0; const pts = [[x, y]]; let dead = false;
    for (let i = 0; i < 900 && x < W + 5 && x > -5 && y > -30 && y < H + 30; i++){
      const dx = cx - x, dy = cy - y, r2 = dx * dx + dy * dy, r = Math.sqrt(r2); if (r < rp){ dead = true; break; }
      vx += K * dx / (r2 * r) * 0.5; vy += K * dy / (r2 * r) * 0.5; const n = Math.hypot(vx, vy); vx /= n; vy /= n; x += vx * 0.5; y += vy * 0.5; if (i % 4 === 0) pts.push([x, y]); }
    line(ctx, pts, dead ? 'rgba(255,229,138,0.45)' : LIGHT, 1.6);
  }
  const kind = bh ? '블랙홀' : R < 30 ? '중성자별 정도' : R < 2e4 ? '백색 왜성 정도' : R < 3e5 ? '압축된 별' : '태양';
  ctx.fillStyle = bh ? '#000' : R < 30 ? '#bfe3ff' : R < 2e4 ? '#ffffff' : '#ffcf5a'; ctx.beginPath(); ctx.arc(cx, cy, rp, 0, 7); ctx.fill();
  if (bh){ ctx.strokeStyle = ORANGE; ctx.lineWidth = 2; ctx.beginPath(); ctx.arc(cx, cy, rp, 0, 7); ctx.stroke(); }
  T(ctx, kind, cx, cy + rp + 16, { color: PALE, bold: true });
  T(ctx, '노란 선: 천체 옆을 지나는 빛', W / 2, 14, { color: DIM, size: 11 });
  const slow = bh ? 0 : Math.sqrt(1 - comp); cl1 += dt * 1.6; cl2 += dt * 1.6 * slow;
  hand(ctx, W * 0.25, 252, 24, cl1, '먼 곳의 시계', '기준');
  hand(ctx, W * 0.75, 252, 24, cl2, '천체 표면의 시계', bh ? '멈춘 것처럼 보임' : slow > 0.99995 ? '거의 같음' : '먼 곳의 ' + fmt(slow * 100, slow > 0.995 ? 2 : 0) + ' %');
  const ve = Math.sqrt(comp) * 3e5;
  setStats([['천체의 반지름', kmTxt(R)], ['표면에서의 탈출 속도', bh ? '빛의 속력 이상' : ve >= 1e4 ? '약 ' + (Math.round(ve / 1e4)).toLocaleString('ko-KR') + '만 km/s' : Math.round(ve).toLocaleString('ko-KR') + ' km/s', ORANGE], ['빛의 속력', '30만 km/s'], ['상태', kind]]);
}
function draw(dt){ const { ctx, W, H } = s; ctx.clearRect(0, 0, W, H); t += dt; if (mode === 'ball') drawBall(dt); else if (mode === 'light') drawLight(dt); else drawBh(dt); }
const TEXT = {
  ball: ['창문이 없는 두 방 안에서 공을 놓습니다. 방 안의 사람이 자신이 어느 방에 있는지 알아낼 수 있을지 생각해 보세요.',
    '가속하는 우주선 안에서는 가속도의 반대 방향으로 관성력이 작용하여, 중력이 작용할 때와 똑같은 일이 일어납니다. 이처럼 중력에 의한 효과와 가속 운동에 의한 관성력의 효과를 구별할 수 없다는 것이 등가 원리입니다. 이것은 물체의 관성 질량과 중력 질량이 같기 때문입니다. 자유 낙하하는 방 안에서는 중력과 관성력이 상쇄되어 중력이 없는 우주 공간과 같은 무중력 상태가 됩니다.'],
  light: ['두 방의 왼쪽 벽에서 빛을 수평으로 쏩니다. 가속도를 바꾸며 빛의 경로를 비교하세요. 실제로는 아주 조금 휘어지므로 크게 과장해서 그렸습니다.',
    '밖에서 보면 빛은 직진하지만, 빛이 방을 건너가는 동안 우주선이 위로 가속하므로 우주선 안에서는 빛이 아래로 휘어져 보입니다. 등가 원리에 따르면 중력이 작용하는 방에서도 같은 일이 일어나야 하므로, 빛은 중력에 의해 휘어집니다. 일반 상대성 이론에서는 질량이 주위의 시공간을 휘게 하고, 빛은 휘어진 시공간을 따라 진행한다고 설명합니다. 먼 은하의 빛이 휘어져 여러 개로 보이는 중력 렌즈 현상이 그 증거입니다.'],
  bh: ['질량은 그대로 두고 천체를 압축합니다. 반지름이 작아질수록 탈출 속도, 빛의 경로, 표면의 시계가 어떻게 달라지는지 관찰하세요. 천체는 같은 크기로 그렸습니다.',
    '천체의 질량이 같아도 반지름이 작을수록 표면의 중력이 커서 탈출 속도가 커집니다. 탈출 속도가 빛의 속력보다 커지면 빛조차 빠져나올 수 없는 블랙홀이 됩니다(태양 질량이면 반지름 약 3 km). 중력이 강한 곳일수록 시공간이 많이 휘어져 빛이 크게 휘고 시간이 느리게 갑니다(중력 시간 지연). 지표면보다 중력이 약한 높은 곳에 있는 위성 항법 장치(GPS) 위성의 시계는 지상의 시계보다 빨리 가므로 이를 보정해야 위치를 정확히 알 수 있습니다.'] };
setupTabs(m => { mode = m; $('hintTxt').textContent = TEXT[m][0]; $('noteTxt').textContent = TEXT[m][1]; tDrop = -1; $('dropB').textContent = '공 놓기'; rs(); });
$('dropB').addEventListener('click', () => { if (tDrop >= 0){ tDrop = -1; $('dropB').textContent = '공 놓기'; } else { tDrop = 0; $('dropB').textContent = '다시 잡기'; } });
$('sitS').addEventListener('change', () => { tDrop = -1; $('dropB').textContent = '공 놓기'; });
loop(draw);
