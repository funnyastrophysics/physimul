돌림힘과 평형
  <h1>돌림힘과 평형</h1>
  <p class="hint" id="hintTxt"></p>
  <div class="card">
    <div class="tabs" id="tabs">
      <button data-m="lever">저울대</button>
      <button data-m="beam">두 받침 위의 막대</button>
    </div>
    <canvas id="sim" style="height:280px"></canvas>
    <div class="stats" id="stats"></div>
  </div>
  <div class="card">
    <div class="controls m-lever">
      <div class="sl"><div class="top"><span>추 A의 질량</span><b id="maV"></b></div>
        <input type="range" id="maS" min="50" max="400" step="50" value="200"><div class="range"><span>50 g</span><span>400 g</span></div></div>
      <div class="sl"><div class="top"><span>추 A의 위치 (받침점 왼쪽)</span><b id="xaV"></b></div>
        <input type="range" id="xaS" min="1" max="10" step="1" value="3"><div class="range"><span>5 cm</span><span>50 cm</span></div></div>
      <div class="sl"><div class="top"><span>추 B의 질량</span><b id="mbV"></b></div>
        <input type="range" id="mbS" min="50" max="400" step="50" value="100"><div class="range"><span>50 g</span><span>400 g</span></div></div>
      <div class="sl"><div class="top"><span>추 B의 위치 (받침점 오른쪽)</span><b id="xbV"></b></div>
        <input type="range" id="xbS" min="1" max="10" step="1" value="4"><div class="range"><span>5 cm</span><span>50 cm</span></div></div>
    </div>
    <div class="controls m-beam">
      <div class="sl"><div class="top"><span>물체의 위치</span><b id="lpV"></b></div>
        <input type="range" id="lpS" min="0" max="4" step="0.05" value="1.5"><div class="range"><span>왼쪽 끝</span><span>오른쪽 끝</span></div></div>
      <div class="sl"><div class="top"><span>물체의 질량</span><b id="lmV"></b></div>
        <input type="range" id="lmS" min="10" max="100" step="5" value="40"><div class="range"><span>10 kg</span><span>100 kg</span></div></div>
      <div class="sl"><div class="top"><span>오른쪽 받침의 위치</span><b id="spV"></b></div>
        <input type="range" id="spS" min="1.5" max="4" step="0.1" value="3"><div class="range"><span>1.5 m</span><span>4.0 m (끝)</span></div></div>
    </div>
    <p class="note" id="noteTxt"></p>
  </div>
---SCRIPT---
const g = 9.8, S = $('sim'); let s; const rs = () => { s = fitCanvas(S); }; window.addEventListener('resize', rs);
let mode, tilt = 0;
bindLabels({ maS: ['maV', v => v + ' g'], mbS: ['mbV', v => v + ' g'], xaS: ['xaV', v => v * 5 + ' cm'], xbS: ['xbV', v => v * 5 + ' cm'],
  lpS: ['lpV', v => v.toFixed(2) + ' m'], lmS: ['lmV', v => v + ' kg'], spS: ['spV', v => v.toFixed(1) + ' m'] });

function drawWeight(ctx, x, y, m, color, label){
  const h = 12 + m / 400 * 22, w = 20 + m / 400 * 10;
  line(ctx, [[x, y], [x, y + 18]], SUB, 1.2);
  ctx.fillStyle = color; ctx.fillRect(x - w / 2, y + 18, w, h); ctx.strokeStyle = INK; ctx.lineWidth = 1; ctx.strokeRect(x - w / 2, y + 18, w, h);
  T(ctx, label, x, y + 18 + h / 2, { color: '#fff', bold: true, size: 11 });
  return y + 18 + h;
}
function lever(dt){
  const { ctx, W, H } = s; ctx.clearRect(0, 0, W, H);
  const ma = +$('maS').value / 1000, mb = +$('mbS').value / 1000, ra = +$('xaS').value * 0.05, rb = +$('xbS').value * 0.05;
  const ta = ma * g * ra, tb = mb * g * rb, net = tb - ta;   // 시계 방향(+)
  const target = Math.abs(net) < 1e-6 ? 0 : Math.sign(net) * 0.16;
  tilt += (target - tilt) * Math.min(1, dt * 4);
  const cx = W / 2, cy = H * 0.34, half = Math.min(W * 0.46, 260), unit = half / 10;
  // 받침
  ctx.fillStyle = '#9aa3b2'; ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx - 18, cy + 40); ctx.lineTo(cx + 18, cy + 40); ctx.closePath(); ctx.fill();
  line(ctx, [[cx - 26, cy + 40], [cx + 26, cy + 40]], INK, 2);
  ctx.save(); ctx.translate(cx, cy); ctx.rotate(tilt);
  ctx.fillStyle = '#c9a66b'; ctx.fillRect(-half, -6, half * 2, 10); ctx.strokeStyle = INK; ctx.lineWidth = 1; ctx.strokeRect(-half, -6, half * 2, 10);
  for (let i = -10; i <= 10; i++){ line(ctx, [[i * unit, 4], [i * unit, 8]], INK, 1); }
  ctx.restore();
  ctx.fillStyle = INK; ctx.beginPath(); ctx.arc(cx, cy, 4, 0, 7); ctx.fill();
  const pos = d => [cx + d * unit * Math.cos(tilt), cy + d * unit * Math.sin(tilt) + 4];
  const [ax, ay] = pos(-+$('xaS').value), [bx, by] = pos(+$('xbS').value);
  const ea = drawWeight(ctx, ax, ay, ma * 1000, BLUE, 'A'), eb = drawWeight(ctx, bx, by, mb * 1000, ORANGE, 'B');
  arrow(ctx, ax, ea + 2, ax, ea + 14 + ma * 90, BLUE, 2.5); arrow(ctx, bx, eb + 2, bx, eb + 14 + mb * 90, ORANGE, 2.5);
  T(ctx, (ma * g).toFixed(2) + ' N', ax, ea + 26 + ma * 90, { color: BLUE, bold: true, size: 11 });
  T(ctx, (mb * g).toFixed(2) + ' N', bx, eb + 26 + mb * 90, { color: ORANGE, bold: true, size: 11 });
  const msg = Math.abs(net) < 1e-6 ? '평형: 돌림힘의 합이 0입니다' : net > 0 ? '시계 방향으로 돌아갑니다' : '시계 반대 방향으로 돌아갑니다';
  T(ctx, msg, W / 2, 16, { bold: true, size: 14, color: Math.abs(net) < 1e-6 ? GREEN : RED });
  setStats([['A의 돌림힘 (시계 반대)', ta.toFixed(3) + ' N·m', BLUE], ['B의 돌림힘 (시계)', tb.toFixed(3) + ' N·m', ORANGE], ['돌림힘의 합', fmt(net, 3) + ' N·m', Math.abs(net) < 1e-6 ? GREEN : RED]]);
}
function beam(){
  const { ctx, W, H } = s; ctx.clearRect(0, 0, W, H);
  const Lb = 4, mbeam = 20, xL = 0, xR = +$('spS').value, xp = +$('lpS').value, m = +$('lmS').value;
  // 평형 조건: N1 + N2 = (m + M)g, 왼쪽 받침 기준 돌림힘: N2·xR = m g xp + M g (L/2)
  const N2 = (m * g * xp + mbeam * g * Lb / 2) / xR, N1 = (m + mbeam) * g - N2, tip = N1 < -1e-6;
  const sc = (W - 60) / Lb, X = x => 30 + x * sc, by = H * 0.52;
  // 넘어질 때는 오른쪽 받침을 중심으로 기울임
  const ang = tip ? 0.25 : 0;
  ctx.save(); ctx.translate(X(xR), by); ctx.rotate(ang); ctx.translate(-X(xR), -by);
  ctx.fillStyle = '#c9a66b'; ctx.fillRect(X(0), by - 12, Lb * sc, 12); ctx.strokeStyle = INK; ctx.lineWidth = 1; ctx.strokeRect(X(0), by - 12, Lb * sc, 12);
  const bw = 34 + m / 100 * 16; ctx.fillStyle = BLUE; ctx.fillRect(X(xp) - bw / 2, by - 12 - bw * 0.8, bw, bw * 0.8);
  T(ctx, m + ' kg', X(xp), by - 12 - bw * 0.4, { color: '#fff', bold: true, size: 11 });
  if (!tip){ arrow(ctx, X(xp), by - 4, X(xp), by + 20 + m * 0.5, BLUE, 2.5); arrow(ctx, X(Lb / 2), by - 4, X(Lb / 2), by + 20 + mbeam * 0.5, GRAY, 2); }
  ctx.restore();
  // 받침
  [xL, xR].forEach(x => { ctx.fillStyle = '#9aa3b2'; ctx.beginPath(); ctx.moveTo(X(x), by); ctx.lineTo(X(x) - 14, by + 34); ctx.lineTo(X(x) + 14, by + 34); ctx.closePath(); ctx.fill(); });
  line(ctx, [[10, by + 34], [W - 10, by + 34]], INK, 2);
  if (!tip){
    arrow(ctx, X(xL), by + 30, X(xL), by + 30 - Math.max(6, N1 / 8), GREEN, 3); arrow(ctx, X(xR), by + 30, X(xR), by + 30 - Math.max(6, N2 / 8), GREEN, 3);
    T(ctx, 'N₁ ' + N1.toFixed(0) + ' N', X(xL) + 4, by + 50, { color: GREEN, bold: true, align: 'left' }); T(ctx, 'N₂ ' + N2.toFixed(0) + ' N', X(xR), by + 50, { color: GREEN, bold: true });
  }
  if (tip){ T(ctx, '넘어집니다!', W / 2, 16, { bold: true, size: 14, color: RED }); T(ctx, '평형이 되려면 왼쪽 받침이 막대를 아래로 당겨야 하는데, 받침은 밀기만 할 수 있어요', W / 2, 36, { size: 11, color: RED }); }
  else T(ctx, '평형: 알짜힘 = 0, 돌림힘의 합 = 0', W / 2, 16, { bold: true, size: 14, color: GREEN });
  if (!tip) T(ctx, '막대 20 kg', X(Lb / 2) + 6, by + 22, { size: 10, align: 'left' });
  setStats([['왼쪽 받침의 힘 N₁', tip ? '−' : N1.toFixed(0) + ' N', GREEN], ['오른쪽 받침의 힘 N₂', tip ? '−' : N2.toFixed(0) + ' N', GREEN], ['전체 무게', ((m + mbeam) * g).toFixed(0) + ' N']]);
}
const TEXT = {
  lever: ['추의 질량과 위치를 바꾸며 저울대가 수평으로 평형을 이루는 조건을 찾아보세요. 받침점은 저울대의 가운데입니다.',
    '돌림힘의 크기 = 힘 × 받침점에서 힘의 작용선까지의 거리(팔의 길이). 시계 방향과 시계 반대 방향 돌림힘의 크기가 같으면 돌림힘의 합이 0이 되어 회전하지 않습니다. 시소, 병따개, 가위, 렌치가 이 원리를 이용합니다.'],
  beam: ['막대 위의 물체를 옮기며 두 받침이 막대를 떠받치는 힘이 어떻게 달라지는지 보세요. 오른쪽 받침을 안쪽으로 옮기고 물체를 끝으로 보내면 어떻게 될까요?',
    '물체가 정지해 있으려면 알짜힘과 돌림힘의 합이 모두 0이어야 합니다. 물체가 받침 바깥으로 너무 나가면 받침이 막대를 아래로 당겨야 하는데, 받침은 밀기만 할 수 있으므로 막대가 넘어집니다. 다리, 크레인, 발코니 같은 구조물은 이런 조건을 고려해 설계합니다.'] };
setupTabs(m => { mode = m; $('hintTxt').textContent = TEXT[m][0]; $('noteTxt').textContent = TEXT[m][1]; rs(); });
loop(dt => mode === 'lever' ? lever(dt) : beam());
