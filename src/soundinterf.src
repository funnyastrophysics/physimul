음파의 간섭
  <h1>음파의 간섭</h1>
  <p class="hint">두 스피커에서 같은 진동수의 소리가 나옵니다. 마이크(초록색)를 끌어 소리가 크게 들리는 곳과 거의 들리지 않는 곳을 찾고, 두 스피커까지의 거리 차이를 파장과 비교하세요.</p>
  <div class="card">
    <canvas id="sim" style="height:330px;border-radius:8px;background:#fff"></canvas>
    <div class="row">
      <select id="viewS"><option value="inst">파동의 순간 모습</option><option value="int">소리 세기 분포</option></select>
      <select id="phS"><option value="0">같은 위상</option><option value="1">반대 위상</option></select>
      <button class="b primary" id="sndB">소리 듣기</button>
    </div>
    <div class="stats" id="stats"></div>
  </div>
  <div class="card">
    <div class="controls">
      <div class="sl"><div class="top"><span>파장 λ</span><b id="lV"></b></div>
        <input type="range" id="lS" min="0.2" max="0.8" step="0.02" value="0.4"><div class="range"><span>0.2 m</span><span>0.8 m</span></div></div>
      <div class="sl"><div class="top"><span>두 스피커 사이 거리 d</span><b id="dV"></b></div>
        <input type="range" id="dS" min="0.4" max="2" step="0.05" value="1.2"><div class="range"><span>0.4 m</span><span>2 m</span></div></div>
    </div>
    <p class="note">두 스피커까지의 거리 차이가 파장의 정수배(0, λ, 2λ, …)인 곳에서는 마루와 마루가 만나 보강 간섭이 일어나 소리가 크게 들리고, 반파장의 홀수배(λ/2, 3λ/2, …)인 곳에서는 마루와 골이 만나 상쇄 간섭이 일어나 소리가 작게 들립니다. 두 스피커의 위상이 반대이면 보강과 상쇄의 위치가 서로 바뀝니다. 소음 제거 헤드폰은 소음과 반대 위상의 소리를 만들어 상쇄 간섭을 일으킵니다.</p>
  </div>
---SCRIPT---
const VS = 340, S = $('sim'); let s, img, cv, cx; const CELL = 3, WM = 4;   // 화면 가로 = 4 m
const rs = () => { s = fitCanvas(S); cv = document.createElement('canvas'); cv.width = Math.ceil(s.W / CELL); cv.height = Math.ceil(s.H / CELL); cx = cv.getContext('2d'); img = cx.createImageData(cv.width, cv.height); };
window.addEventListener('resize', rs); rs();
bindLabels({ lS: ['lV', v => v.toFixed(2) + ' m (' + (VS / v).toFixed(0) + ' Hz)'], dS: ['dV', v => v.toFixed(2) + ' m'] });
let t = 0, mic = { x: 2.6, y: 0 }, snd = null;
const k = () => s.W / WM, X = x => x * k(), Y = y => s.H / 2 - y * k();
const spk = () => { const d = +$('dS').value; return [{ x: 0.25, y: d / 2 }, { x: 0.25, y: -d / 2 }]; };
function amp(x, y, ph){ const lam = +$('lS').value, K = 2 * Math.PI / lam, sg = $('phS').value === '1' ? Math.PI : 0; let re = 0, im = 0;
  spk().forEach((p, i) => { const r = Math.max(Math.hypot(x - p.x, y - p.y), 0.05), a = 1 / Math.sqrt(r), q = K * r - ph + (i ? sg : 0); re += a * Math.cos(q); im += a * Math.sin(q); }); return [re, im]; }
function draw(dt){
  const { ctx, W, H } = s; t += dt; const ph = 2 * Math.PI * t * 1.2, mode = $('viewS').value, kk = k(), d = img.data;
  for (let j = 0; j < cv.height; j++) for (let i = 0; i < cv.width; i++){
    const x = (i + 0.5) * CELL / kk, y = (H / 2 - (j + 0.5) * CELL) / kk, [re, im] = amp(x, y, 0), o = (j * cv.width + i) * 4;
    if (mode === 'inst'){ const v = (re * Math.cos(ph) + im * Math.sin(ph)) * 0.55, c = Math.max(-1, Math.min(1, v));
      if (c > 0){ d[o] = 255 - 200 * c; d[o + 1] = 255 - 130 * c; d[o + 2] = 255 - 20 * c; } else { d[o] = 255 + 10 * c; d[o + 1] = 255 + 150 * c; d[o + 2] = 255 + 180 * c; } }
    else { const I = Math.min(1, (re * re + im * im) * 0.28); d[o] = 255 - 230 * I; d[o + 1] = 255 - 160 * I; d[o + 2] = 255 - 40 * I; }
    d[o + 3] = 255; }
  cx.putImageData(img, 0, 0); ctx.clearRect(0, 0, W, H); ctx.imageSmoothingEnabled = true; ctx.drawImage(cv, 0, 0, cv.width * CELL, cv.height * CELL);
  spk().forEach((p, i) => { const x = X(p.x), y = Y(p.y); ctx.fillStyle = INK; ctx.fillRect(x - 14, y - 11, 10, 22); ctx.beginPath(); ctx.moveTo(x - 4, y - 6); ctx.lineTo(x + 6, y - 14); ctx.lineTo(x + 6, y + 14); ctx.lineTo(x - 4, y + 6); ctx.fill(); T(ctx, i ? 'S₂' : 'S₁', x - 9, y + (i ? 26 : -18), { bold: true, size: 12 }); });
  const mx = X(mic.x), my = Y(mic.y);
  spk().forEach(p => line(ctx, [[X(p.x) + 6, Y(p.y)], [mx, my]], 'rgba(30,35,45,0.45)', 1.2, [5, 4]));
  ctx.fillStyle = 'rgba(46,158,106,0.25)'; ctx.beginPath(); ctx.arc(mx, my, 20, 0, 7); ctx.fill(); ctx.fillStyle = GREEN; ctx.beginPath(); ctx.arc(mx, my, 8, 0, 7); ctx.fill();
  T(ctx, '마이크 (끌기)', mx, my > H - 40 ? my - 26 : my + 32, { color: GREEN, bold: true, size: 11 });
  // 마이크 위치의 진폭
  const [re, im] = amp(mic.x, mic.y, 0), A = Math.hypot(re, im), [p1, p2] = spk(), r1 = Math.hypot(mic.x - p1.x, mic.y - p1.y), r2 = Math.hypot(mic.x - p2.x, mic.y - p2.y), Am = 1 / Math.sqrt(r1) + 1 / Math.sqrt(r2), rel = A / Am;
  const bw = 90, bx = W - bw - 10, by = 12; ctx.fillStyle = 'rgba(255,255,255,0.9)'; ctx.fillRect(bx - 6, by - 4, bw + 12, 36); ctx.fillStyle = '#e3e6ea'; ctx.fillRect(bx, by + 14, bw, 10); ctx.fillStyle = GREEN; ctx.fillRect(bx, by + 14, bw * rel, 10);
  T(ctx, '마이크 소리 크기', bx + bw / 2, by + 6, { size: 11, bold: true });
  const lam = +$('lS').value, dd = Math.abs(r1 - r2), n = dd / lam;
  const anti = $('phS').value === '1', fr = n - Math.floor(n), near = x => Math.min(x, 1 - x);
  const kind = (anti ? near(Math.abs(fr - 0.5)) : near(fr)) < 0.12 ? ['보강 간섭', ORANGE] : (anti ? near(fr) : near(Math.abs(fr - 0.5))) < 0.12 ? ['상쇄 간섭', BLUE] : ['중간', SUB];
  setStats([['거리 차이 |S₁P − S₂P|', dd.toFixed(2) + ' m'], ['거리 차이 ÷ 파장', n.toFixed(2) + ' λ'], ['마이크 위치', kind[0], kind[1]], ['진동수', (VS / lam).toFixed(0) + ' Hz']]);
  if (snd) snd.set(VS / lam, 0.25 * rel * rel + 0.002);
}
pointer(S, (x, y) => { if (Math.hypot(x - X(mic.x), y - Y(mic.y)) > 36) return false; }, (x, y) => { mic.x = Math.max(0.5, Math.min(WM - 0.05, x / k())); mic.y = (s.H / 2 - Math.max(4, Math.min(s.H - 4, y))) / k(); });
$('sndB').addEventListener('click', () => { if (snd){ snd.stop(); snd = null; $('sndB').textContent = '소리 듣기'; } else { snd = tone(); $('sndB').textContent = '소리 끄기'; } });
loop(draw);
