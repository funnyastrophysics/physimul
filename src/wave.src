탄성파의 진행, 반사, 투과
  <h1>탄성파의 진행, 반사, 투과</h1>
  <p class="hint" id="hintTxt"></p>
  <div class="card">
    <div class="tabs" id="tabs">
      <button data-m="kind">횡파와 종파</button>
      <button data-m="refl">끝에서의 반사</button>
      <button data-m="trans">두 매질의 경계</button>
    </div>
    <canvas id="sim" style="height:260px;border-radius:8px"></canvas>
    <div class="row m-kind"><select id="kindS"><option value="t">횡파 (줄의 파동)</option><option value="l">종파 (용수철의 파동)</option></select></div>
    <div class="row m-refl m-trans">
      <button class="b primary" id="pulseB">펄스 보내기</button>
      <select id="endS" class="m-refl"><option value="fixed">고정단 (벽에 묶음)</option><option value="free">자유단 (고리에 걸어 자유롭게)</option></select>
      <select id="medS" class="m-trans"><option value="slow">가벼운 줄 → 무거운 줄 (느려짐)</option><option value="fast">무거운 줄 → 가벼운 줄 (빨라짐)</option></select>
      <button class="b" id="slowB">느리게</button>
    </div>
    <div class="stats" id="stats"></div>
  </div>
  <div class="card">
    <div class="controls m-kind">
      <div class="sl"><div class="top"><span>진동수 f</span><b id="fV"></b></div>
        <input type="range" id="fS" min="0.5" max="3" step="0.1" value="1"><div class="range"><span>0.5 Hz</span><span>3 Hz</span></div></div>
      <div class="sl"><div class="top"><span>파동의 속력 v</span><b id="vV"></b></div>
        <input type="range" id="vS" min="0.5" max="2" step="0.1" value="1"><div class="range"><span>0.5 m/s</span><span>2 m/s</span></div></div>
    </div>
    <p class="note" id="noteTxt"></p>
  </div>
---SCRIPT---
const S = $('sim'); let s; const rs = () => { s = fitCanvas(S); }; window.addEventListener('resize', rs);
let mode, t = 0, slow = 1;
bindLabels({ fS: ['fV', v => v.toFixed(1) + ' Hz'], vS: ['vV', v => v.toFixed(1) + ' m/s'] });
// ---------- 횡파와 종파 ----------
function kind(dt){
  const { ctx, W, H } = s; ctx.clearRect(0, 0, W, H); ctx.fillStyle = '#fbfcfd'; ctx.fillRect(0, 0, W, H);
  t += dt; const f = +$('fS').value, v = +$('vS').value, lam = v / f, Lm = 3, X = x => 20 + x / Lm * (W - 40), cy = H / 2, A = 36, tr = $('kindS').value === 't';
  const N = tr ? 46 : 70;
  // 파장 표시
  const x0 = (Math.ceil((v * t) / lam) * lam - v * t) % lam + lam * 0.25;
  if (lam < Lm){ const xa = X(x0), xb = X(x0 + lam); line(ctx, [[xa, 26], [xb, 26]], PURPLE, 1.5); line(ctx, [[xa, 20], [xa, 32]], PURPLE, 1.5); line(ctx, [[xb, 20], [xb, 32]], PURPLE, 1.5); T(ctx, '파장 λ = ' + lam.toFixed(2) + ' m', (xa + xb) / 2, 12, { color: PURPLE, bold: true, size: 11 }); }
  for (let i = 0; i < N; i++){
    const x = Lm * i / (N - 1), ph = 2 * Math.PI * (f * t - x / lam), d = Math.max(0, Math.min(1, (v * t - x) * 4)) * Math.sin(ph);
    const px = tr ? X(x) : X(x) + d * 14, py = tr ? cy - d * A : cy;
    if (tr && i > 0){ const xp = Lm * (i - 1) / (N - 1), php = 2 * Math.PI * (f * t - xp / lam), dp = Math.max(0, Math.min(1, (v * t - xp) * 4)) * Math.sin(php); line(ctx, [[X(xp), cy - dp * A], [px, py]], GRAY, 1.2); }
    ctx.fillStyle = i === Math.round(N * 0.45) ? RED : BLUE; ctx.beginPath(); ctx.arc(px, py, tr ? 4.5 : 3.5, 0, 7); ctx.fill();
    if (!tr){ ctx.strokeStyle = 'rgba(47,111,223,0.25)'; ctx.beginPath(); ctx.moveTo(px, cy - 30); ctx.lineTo(px, cy + 30); ctx.stroke(); }
  }
  T(ctx, tr ? '매질의 진동 방향 ↕, 파동의 진행 방향 →' : '매질의 진동 방향 ↔, 파동의 진행 방향 →', W / 2, H - 14, { bold: true, color: INK, size: 12 });
  T(ctx, '빨간 점: 매질의 한 점 (제자리에서 진동만 함)', W / 2, H - 32, { color: RED, size: 11 });
  setStats([['진동수 f', f.toFixed(1) + ' Hz'], ['주기 T = 1/f', (1 / f).toFixed(2) + ' s'], ['파장 λ = v/f', lam.toFixed(2) + ' m', PURPLE], ['속력 v', v.toFixed(1) + ' m/s']]);
}
// ---------- 1차원 파동 방정식 (반사·투과) ----------
const N = 400; let y = new Float32Array(N), yp = new Float32Array(N), c = new Float32Array(N), pulseT = -1, info = '';
function setupMedium(){ for (let i = 0; i < N; i++){ if (mode === 'trans'){ const fast = $('medS').value === 'fast'; c[i] = i < N / 2 ? (fast ? 0.5 : 1) : (fast ? 1 : 0.5); } else c[i] = 1; } y.fill(0); yp.fill(0); pulseT = -1; }
function stepWave(){
  const yn = new Float32Array(N), r = 1;   // Courant 수 (빠른 매질에서 1이면 파형이 퍼지지 않음)
  for (let i = 1; i < N - 1; i++){ const k = (c[i] * r) ** 2; yn[i] = 2 * y[i] - yp[i] + k * (y[i + 1] - 2 * y[i] + y[i - 1]); }
  // 왼쪽 끝: 펄스 발생기
  if (pulseT >= 0 && pulseT < 60){ pulseT += 1; yn[0] = Math.sin(Math.PI * pulseT / 60) ** 2; }
  else { const k = c[0] * r; yn[0] = y[1] + (k - 1) / (k + 1) * (yn[1] - y[0]); if (pulseT >= 0) pulseT += 1; }   // 펄스를 보낸 뒤 왼쪽 끝은 흡수 경계
  // 오른쪽 끝
  if (mode === 'refl' && $('endS').value === 'free') yn[N - 1] = yn[N - 2]; else if (mode === 'refl') yn[N - 1] = 0;
  else { const k = c[N - 1] * r; yn[N - 1] = y[N - 2] + (k - 1) / (k + 1) * (yn[N - 2] - y[N - 1]); }   // 흡수 경계
  yp = y; y = yn;
}
function waveDraw(dt){
  const steps = Math.round(dt * 220 * slow); for (let k = 0; k < steps; k++) stepWave();
  const { ctx, W, H } = s; ctx.clearRect(0, 0, W, H); ctx.fillStyle = '#fbfcfd'; ctx.fillRect(0, 0, W, H);
  const X = i => 20 + i / (N - 1) * (W - 50), cy = H / 2, A = H * 0.3;
  if (mode === 'trans'){ const fast = $('medS').value === 'fast';
    ctx.fillStyle = 'rgba(47,111,223,0.06)'; ctx.fillRect(X(fast ? 0 : N / 2), 0, X(N / 2) - X(0), H);
    T(ctx, fast ? '무거운 줄 (느림)' : '가벼운 줄 (빠름)', X(N / 4), 16, { bold: true, color: INK }); T(ctx, fast ? '가벼운 줄 (빠름)' : '무거운 줄 (느림)', X(3 * N / 4), 16, { bold: true, color: INK });
    line(ctx, [[X(N / 2), 30], [X(N / 2), H - 30]], GRAY, 1, true); }
  ctx.strokeStyle = INK; ctx.beginPath();
  for (let i = 0; i < N; i++){ const px = X(i), py = cy - y[i] * A; i ? ctx.lineTo(px, py) : ctx.moveTo(px, py); }
  ctx.lineWidth = 1.5; ctx.stroke();
  if (mode === 'trans'){ ctx.strokeStyle = INK; ctx.lineWidth = 4; ctx.beginPath(); const fast = $('medS').value === 'fast'; for (let i = fast ? 0 : N / 2; i < (fast ? N / 2 : N); i++){ const px = X(i), py = cy - y[i] * A; i === (fast ? 0 : N / 2) ? ctx.moveTo(px, py) : ctx.lineTo(px, py); } ctx.stroke(); }
  if (mode === 'refl'){ const fixed = $('endS').value === 'fixed', ex = X(N - 1);
    if (fixed){ ctx.fillStyle = '#9aa3b2'; ctx.fillRect(ex, 30, 14, H - 60); for (let k = 30; k < H - 30; k += 10) line(ctx, [[ex + 14, k], [ex + 4, k + 8]], WIRE, 1); }
    else { line(ctx, [[ex + 6, 30], [ex + 6, H - 30]], WIRE, 3); ctx.strokeStyle = ORANGE; ctx.lineWidth = 2; ctx.beginPath(); ctx.arc(ex + 6, cy - y[N - 1] * A, 6, 0, 7); ctx.stroke(); } }
  ctx.fillStyle = BLUE; ctx.fillRect(4, cy - y[0] * A - 10, 12, 20);
  T(ctx, '손', 10, cy + 24, { size: 10 });
  if (pulseT < 0) T(ctx, '[펄스 보내기]를 누르세요', W / 2, H - 14, { bold: true, color: BLUE });
  const items = mode === 'refl' ? [['끝의 종류', $('endS').value === 'fixed' ? '고정단' : '자유단'], ['반사파', $('endS').value === 'fixed' ? '뒤집혀서 돌아옴 (위상 반대)' : '그대로 돌아옴 (위상 같음)', ORANGE]]
    : [['경계에서 반사파', $('medS').value === 'slow' ? '뒤집혀서 돌아옴' : '그대로 돌아옴', ORANGE], ['투과파', '뒤집히지 않음, ' + ($('medS').value === 'slow' ? '느려지고 폭이 좁아짐' : '빨라지고 폭이 넓어짐')]];
  setStats(items);
}
const TEXT = {
  kind: ['파동이 진행할 때 매질은 제자리에서 진동할 뿐 파동과 함께 이동하지 않습니다. 횡파와 종파를 비교하고, 진동수와 속력을 바꾸며 파장의 변화를 관찰하세요.',
    '매질의 진동 방향이 파동의 진행 방향과 수직이면 횡파, 나란하면 종파입니다. 소리는 공기의 종파이고, 지진파의 P파는 종파, S파는 횡파입니다. 파동의 속력, 진동수, 파장 사이에는 v = fλ의 관계가 있습니다. 같은 매질에서는 속력이 일정하므로 진동수가 커지면 파장이 짧아집니다.'],
  refl: ['줄의 끝을 벽에 묶었을 때(고정단)와 자유롭게 움직이게 했을 때(자유단), 반사된 펄스의 모양을 비교하세요.',
    '고정단에서는 줄이 움직이지 못하므로 반사파의 위상이 반대로 바뀌어 뒤집힌 펄스가 돌아옵니다. 자유단에서는 위상이 바뀌지 않아 같은 모양의 펄스가 돌아옵니다.'],
  trans: ['파동이 속력이 다른 매질로 넘어갈 때 경계에서 일부는 반사되고 일부는 투과합니다. 반사파와 투과파의 모양과 폭을 비교하세요.',
    '파동이 느린 매질(무거운 줄)로 들어갈 때 반사파는 위상이 반대로 바뀌고, 빠른 매질로 들어갈 때는 위상이 바뀌지 않습니다. 투과파는 항상 위상이 그대로이며, 진동수는 변하지 않고 속력에 따라 파장(펄스의 폭)이 달라집니다. 초음파 영상 장치와 비파괴 검사는 경계에서 반사되는 탄성파를 이용합니다.'] };
setupTabs(m => { mode = m; $('hintTxt').textContent = TEXT[m][0]; $('noteTxt').textContent = TEXT[m][1]; rs(); setupMedium(); });
$('pulseB').addEventListener('click', () => { setupMedium(); pulseT = 0; });
$('endS').addEventListener('change', setupMedium); $('medS').addEventListener('change', setupMedium);
$('slowB').addEventListener('click', () => { slow = slow === 1 ? 0.35 : 1; $('slowB').classList.toggle('on', slow < 1); });
loop(dt => mode === 'kind' ? kind(dt) : waveDraw(dt));
