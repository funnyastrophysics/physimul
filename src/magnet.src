자성체와 자기 구역
  <h1>자성체와 자기 구역</h1>
  <p class="hint" id="hintTxt"></p>
  <div class="card">
    <div class="tabs" id="tabs">
      <button data-m="ferro">강자성체</button>
      <button data-m="para">상자성체</button>
      <button data-m="dia">반자성체</button>
    </div>
    <canvas id="sim" style="height:270px;border-radius:8px;background:#fbfcfd"></canvas>
    <div class="row"><button class="b primary" id="zeroB">외부 자기장 제거</button><button class="b" id="resetB">처음으로</button></div>
    <div class="stats" id="stats"></div>
  </div>
  <div class="card">
    <div class="sl"><div class="top"><span>외부 자기장</span><b id="bV"></b></div>
      <input type="range" id="bS" min="-100" max="100" step="5" value="0"><div class="range"><span>← 왼쪽으로 세게</span><span>오른쪽으로 세게 →</span></div></div>
  </div>
  <div class="card"><canvas id="graph" style="height:220px"></canvas><p class="note" id="noteTxt"></p></div>
---SCRIPT---
const S = $('sim'), G = $('graph'); let s, gr; const rs = () => { s = fitCanvas(S); gr = fitCanvas(G); }; window.addEventListener('resize', rs);
const NX = 12, NY = 6, TAU = Math.PI * 2;
let mode, cells = [], doms = [], trace = [], M = 0;
bindLabels({ bS: ['bV', v => v === 0 ? '0 (없음)' : (v > 0 ? '오른쪽 ' : '왼쪽 ') + Math.abs(v) + ' %'] });
function init(){
  trace = []; M = 0;
  doms = Array.from({ length: 8 }, (_, k) => ({ x: Math.random() * NX, y: Math.random() * NY, th: k * TAU / 8 + Math.random() * 0.5, a: 0, dir: 1, r: Math.random() * 0.6 }));
  cells = [];
  for (let j = 0; j < NY; j++) for (let i = 0; i < NX; i++){
    let best = 0, bd = 1e9; doms.forEach((d, k) => { const q = (d.x - i - 0.5) ** 2 + (d.y - j - 0.5) ** 2; if (q < bd){ bd = q; best = k; } });
    cells.push({ i, j, d: best, th: Math.random() * TAU, w: (Math.random() - 0.5) * 3 }); }
}
// 각도 a에서 b 쪽으로 k만큼(0~1) 돌린 각
const turn = (a, b, k) => a + ((((b - a) % TAU) + TAU * 1.5) % TAU - Math.PI) * k;
function step(dt){
  const B = +$('bS').value / 100, aB = Math.abs(B), sg = Math.sign(B);
  if (mode === 'ferro'){
    doms.forEach(d => {
      if (aB > 0){
        if (d.a <= 0) d.dir = sg;
        if (d.dir === sg){ const target = Math.min(1, aB * 1.4); if (d.a < target) d.a = Math.min(target, d.a + dt * (0.5 + d.r) * (0.4 + aB)); }
        else if (aB > 0.12 + d.r * 0.25){ d.a -= dt * (0.5 + d.r) * (0.4 + aB); if (d.a <= 0){ d.a = 0; d.dir = sg; } }
      } });
    let sum = 0; cells.forEach(c => { const d = doms[c.d]; sum += Math.cos(turn(d.th, d.dir > 0 ? 0 : Math.PI, d.a)); }); M = sum / cells.length;
  } else if (mode === 'para'){ cells.forEach(c => { c.th += (c.w + (Math.random() - 0.5) * 8) * dt; }); M += (0.3 * B - M) * Math.min(1, dt * 6); }
  else { M += (-0.1 * B - M) * Math.min(1, dt * 6); }
  const b = +$('bS').value, last = trace[trace.length - 1];
  if (!last || Math.abs(last[0] - b) > 0.5 || Math.abs(last[1] - M) > 0.004){ trace.push([b, M]); if (trace.length > 4000) trace.shift(); }
}
function draw(dt){
  step(dt);
  const { ctx, W, H } = s; ctx.clearRect(0, 0, W, H);
  const B = +$('bS').value / 100, aB = Math.abs(B), sg = Math.sign(B);
  const bx = W * 0.08, bw = W * 0.84, by = 72, bh = 132, cw = bw / NX, ch = bh / NY;
  // 외부 자기장 화살표
  T(ctx, aB ? '외부 자기장' : '외부 자기장 없음', W / 2, 16, { color: aB ? BLUE : GRAY, bold: true });
  if (aB) for (const y of [42, by + bh + 26]) for (let k = 0; k < 4; k++){ const cx = W * (0.2 + 0.2 * k), L = 8 + 22 * aB; arrow(ctx, cx - sg * L, y, cx + sg * L, y, BLUE, 2.5, 8); }
  // 자성체
  ctx.fillStyle = '#eef1f6'; ctx.fillRect(bx, by, bw, bh);
  cells.forEach(c => {
    const x = bx + (c.i + 0.5) * cw, y = by + (c.j + 0.5) * ch, L = Math.min(cw, ch) * 0.4; let th, len = L, col = RED;
    if (mode === 'ferro'){ const d = doms[c.d]; th = turn(d.th, d.dir > 0 ? 0 : Math.PI, d.a);
      ctx.fillStyle = `hsl(${c.d * 45},45%,90%)`; ctx.fillRect(bx + c.i * cw, by + c.j * ch, cw + 0.5, ch + 0.5); }
    else if (mode === 'para'){ th = aB ? turn(c.th, sg > 0 ? 0 : Math.PI, 0.55 * aB) : c.th; }
    else { th = sg > 0 ? Math.PI : 0; len = L * 0.75 * aB; col = PURPLE; }
    if (mode === 'dia' && len < 2){ ctx.fillStyle = GRAY; ctx.beginPath(); ctx.arc(x, y, 2, 0, 7); ctx.fill(); }
    else arrow(ctx, x - Math.cos(th) * len, y - Math.sin(th) * len, x + Math.cos(th) * len, y + Math.sin(th) * len, col, 1.8, 5);
  });
  ctx.strokeStyle = WIRE; ctx.lineWidth = 2; ctx.strokeRect(bx, by, bw, bh);
  T(ctx, mode === 'ferro' ? '색이 같은 구역 = 자기 구역' : mode === 'para' ? '화살표 = 원자 하나하나의 자석' : '화살표 = 외부 자기장 때문에 생긴 자석', W / 2, H - 12, { size: 11 });
  const dirTxt = v => Math.abs(v) < 0.02 ? '없음' : (v > 0 ? '오른쪽 ' : '왼쪽 ') + Math.round(Math.abs(v) * 100) + ' %';
  setStats([['외부 자기장', aB ? (sg > 0 ? '오른쪽' : '왼쪽') : '없음', BLUE], ['자기화 (자석이 된 정도)', dirTxt(M), mode === 'dia' ? PURPLE : RED],
    ['자석을 가까이 하면', mode === 'ferro' ? '강하게 끌려옴' : mode === 'para' ? '약하게 끌려옴' : '약하게 밀려남']]);
  // 그래프
  const g = gr.ctx; g.clearRect(0, 0, gr.W, gr.H);
  const A = axes(g, gr.W, gr.H, { x0: -100, x1: 100, y0: -1.1, y1: 1.1, xt: [-100, -50, 0, 50, 100], yt: [-1, 0, 1], xl: '외부 자기장 (%)  ← 왼쪽 | 오른쪽 →', yl: '자기화', top: 14 });
  line(g, [[A.X(-100), A.Y(0)], [A.X(100), A.Y(0)]], GRAY, 1); line(g, [[A.X(0), A.Y(-1.1)], [A.X(0), A.Y(1.1)]], GRAY, 1);
  if (trace.length > 1) line(g, trace.map(p => [A.X(p[0]), A.Y(p[1])]), mode === 'dia' ? PURPLE : RED, 2.2);
  g.fillStyle = INK; g.beginPath(); g.arc(A.X(+$('bS').value), A.Y(M), 5, 0, 7); g.fill();
}
const TEXT = {
  ferro: ['강자성체 안에는 원자 자석이 같은 방향으로 정렬된 자기 구역이 있습니다. 외부 자기장을 걸었다가 제거하고, 반대 방향으로도 걸어 보세요.',
    '강자성체(철, 니켈, 코발트)는 외부 자기장을 걸면 자기 구역들이 외부 자기장 방향으로 정렬되어 강하게 자기화되고, 외부 자기장을 제거해도 자기화된 상태를 오래 유지합니다. 그래서 그래프가 올라갈 때와 내려갈 때 다른 길을 지납니다. 이 성질은 영구 자석, 하드 디스크의 정보 저장, 전동기와 변압기의 철심, 마그네틱 카드에 이용됩니다.'],
  para: ['상자성체는 원자 자석의 방향이 제각각입니다. 외부 자기장을 걸었다가 제거해 보세요.',
    '상자성체(알루미늄, 마그네슘, 산소, 종이)는 외부 자기장을 걸면 원자 자석이 외부 자기장 방향으로 약하게 정렬되어 약하게 자기화되고, 외부 자기장을 제거하면 자기화된 상태가 바로 사라집니다. 그래서 자석에 아주 약하게 끌립니다. 액체 산소가 자석의 두 극 사이에 붙어 있는 현상이 그 예입니다.'],
  dia: ['반자성체는 외부 자기장이 없을 때 원자가 자석의 성질을 띠지 않습니다. 외부 자기장을 걸고 화살표의 방향을 확인하세요.',
    '반자성체(구리, 유리, 물, 금, 플라스틱)는 외부 자기장을 걸면 외부 자기장과 반대 방향으로 약하게 자기화되고, 외부 자기장을 제거하면 자기화된 상태가 바로 사라집니다. 그래서 자석에 아주 약하게 밀려납니다. 초전도체는 외부 자기장을 완전히 밀어내므로 자석 위에 뜨며, 이 현상은 자기 부상 열차에 이용됩니다.'] };
setupTabs(m => { mode = m; $('hintTxt').textContent = TEXT[m][0]; $('noteTxt').textContent = TEXT[m][1]; $('bS').value = 0; $('bS').dispatchEvent(new Event('input')); init(); rs(); });
$('zeroB').addEventListener('click', () => { $('bS').value = 0; $('bS').dispatchEvent(new Event('input')); });
$('resetB').addEventListener('click', () => { $('bS').value = 0; $('bS').dispatchEvent(new Event('input')); init(); });
loop(draw);
